package com.alarm.application;

final class Shapes {
    static final int N = 180;

    static float[] poly(int n, int w) {
        float[] r = new float[N];
        double seg = 2 * Math.PI / n;
        for (int i = 0; i < N; i++) {
            double th = i * 2 * Math.PI / N + Math.PI / 2;
            double a = th % seg;
            if (a < 0) a += seg;
            r[i] = (float) (Math.cos(Math.PI / n) / Math.cos(a - Math.PI / n));
        }
        return norm(smooth(r, w));
    }

    static float[] smooth(float[] a, int w) {
        float[] o = new float[N];
        for (int i = 0; i < N; i++) {
            float s = 0;
            for (int k = -w; k <= w; k++) {
                s += a[(i + k + N * 2) % N];
            }
            o[i] = s / (2 * w + 1);
        }
        return o;
    }

    static float[] norm(float[] a) {
        float m = 0;
        for (float x : a) m = Math.max(m, x);
        for (int i = 0; i < N; i++) a[i] /= m;
        return a;
    }
    static float[] wave(int lobes, double amp) {
        float[] r = new float[N];
        for (int i = 0; i < N; i++) {
            double th = i * 2 * Math.PI / N + Math.PI / 2;
            r[i] = (float) (1.0 + amp * Math.cos(lobes * th));
        }
        return norm(r);
    }

    static float[] oval(double a, double b) {
        float[] r = new float[N];
        for (int i = 0; i < N; i++) {
            double th = i * 2 * Math.PI / N;
            r[i] = (float) (a * b / Math.sqrt(Math.pow(b * Math.cos(th), 2)
                    + Math.pow(a * Math.sin(th), 2)));
        }
        return norm(r);
    }

    /** 严格对应录屏：十芒星 -> 五边形 -> 方枕 -> 四叶草 -> 八瓣圆 -> 正圆 -> 七瓣章 -> 椭圆胶囊 */
    static float[][] build() {
        float[][] s = new float[8][];
        s[0] = wave(10, 0.13);       // 00:00 / 00:05 十芒齿轮星
        s[1] = poly(5, 9);           // 00:06 / 00:15 圆角正五边形
        s[2] = poly(4, 13);          // 00:07 圆角方枕
        s[3] = wave(4, 0.19);        // 00:08 四叶草 (四向内凹)
        s[4] = wave(8, 0.07);        // 00:01 / 00:10 八瓣柔和波浪圆
        float[] circle = new float[N];
        java.util.Arrays.fill(circle, 1f);
        s[5] = circle;               // 00:02 / 00:11 柔和正圆
        s[6] = wave(7, 0.095);       // 00:03 / 00:12 七瓣花章
        s[7] = oval(1.0, 0.66);      // 00:04 / 00:13 斜置椭圆胶囊
        return s;
    }
}
