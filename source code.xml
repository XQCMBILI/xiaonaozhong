<file path="小闹钟/app/src/main/java/com/alarm/application/CloudGlow.java">
package com.alarm.application;

import android.animation.ValueAnimator;
import android.content.Context;
import android.graphics.Canvas;
import android.graphics.Paint;
import android.graphics.RadialGradient;
import android.graphics.Shader;
import android.view.View;
import android.widget.NumberPicker;

import java.util.ArrayList;
import java.util.List;

public class CloudGlow extends View {
    private static final int STOPS = 14;

    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
    private final List<View> anchors = new ArrayList<View>();
    private final List<Shader[]> shaders = new ArrayList<Shader[]>();
    private final int[] me = new int[2];
    private final int[] at = new int[2];
    private float breathe;
    private float energy;
    private ValueAnimator loop;
    private ValueAnimator boost;

    public CloudGlow(Context c) {
        super(c);
    }

    void bind(NumberPicker np, int color) {
        PickerStyle.style(np);
        np.setOnScrollListener(new NumberPicker.OnScrollListener() {
            @Override
            public void onScrollStateChange(NumberPicker v, int state) {
                push(state == SCROLL_STATE_IDLE ? 0f : 1f);
            }
        });
        int soft = Ui.dark ? 0xB0 : 0x90;
        int core = Ui.dark ? 0x98 : 0x78;
        anchors.add(np);
        shaders.add(new Shader[]{cloud(color, soft), cloud(color, core)});
    }

    /**
     * 平滑衰减的云团：alpha = a * (1 - t^2)^2，
     * 中心和边缘的斜率都为 0，没有明显的“边”，两团光重叠时也不会出现分界线。
     */
    private static Shader cloud(int color, int a) {
        int[] cols = new int[STOPS];
        float[] pos = new float[STOPS];
        for (int i = 0; i < STOPS; i++) {
            float t = i / (float) (STOPS - 1);
            float k = 1f - t * t;
            float f = k * k;
            cols[i] = Tones.alpha(color, Math.round(a * f));
            pos[i] = t;
        }
        return new RadialGradient(0f, 0f, 1f, cols, pos, Shader.TileMode.CLAMP);
    }

    private void push(float to) {
        if (boost != null) boost.cancel();
        boost = ValueAnimator.ofFloat(energy, to);
        boost.setDuration(to > energy ? 160 : 450);
        boost.addUpdateListener(new ValueAnimator.AnimatorUpdateListener() {
            @Override
            public void onAnimationUpdate(ValueAnimator a) {
                energy = (Float) a.getAnimatedValue();
                invalidate();
            }
        });
        boost.start();
    }

    @Override
    protected void onAttachedToWindow() {
        super.onAttachedToWindow();
        loop = ValueAnimator.ofFloat(0f, 1f);
        loop.setDuration(6000);
        loop.setRepeatCount(ValueAnimator.INFINITE);
        loop.addUpdateListener(new ValueAnimator.AnimatorUpdateListener() {
            @Override
            public void onAnimationUpdate(ValueAnimator a) {
                breathe = (Float) a.getAnimatedValue();
                invalidate();
            }
        });
        loop.start();
    }

    @Override
    protected void onDetachedFromWindow() {
        if (loop != null) loop.cancel();
        if (boost != null) boost.cancel();
        super.onDetachedFromWindow();
    }

    @Override
    protected void onDraw(Canvas canvas) {
        getLocationOnScreen(me);
        for (int i = 0; i < anchors.size(); i++) {
            View a = anchors.get(i);
            a.getLocationOnScreen(at);
            float cx = at[0] - me[0] + a.getWidth() / 2f;
            float cy = at[1] - me[1] + a.getHeight() / 2f;
            double ph = Math.PI * 2 * (breathe + i * 0.33f);
            float k = 1f + 0.05f * (float) Math.sin(ph) + 0.12f * energy;
            float w = a.getWidth();
            float h = Ui.dp(getContext(), 44);
            layer(canvas, shaders.get(i)[0], cx, cy, w * 0.95f * k, h * k, 0.85f + 0.15f * energy);
            layer(canvas, shaders.get(i)[1], cx, cy, w * 0.55f * k, h * 0.6f * k, 0.8f + 0.2f * energy);
        }
    }

    private void layer(Canvas c, Shader s, float cx, float cy, float rx, float ry, float alpha) {
        paint.setShader(s);
        paint.setAlpha((int) (255 * Math.min(1f, alpha)));
        c.save();
        c.translate(cx, cy);
        c.scale(rx, ry);
        c.drawCircle(0f, 0f, 1f, paint);
        c.restore();
    }
}
</file>

