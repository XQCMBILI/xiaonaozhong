package com.alarm.application;

import android.content.Context;
import android.content.SharedPreferences;

import java.util.ArrayList;
import java.util.Calendar;
import java.util.List;
import java.util.Locale;

final class Stats {
    static final int EARLY_HOUR = 8;

    private static SharedPreferences sp(Context c) {
        return c.getSharedPreferences("stats", Context.MODE_PRIVATE);
    }

    private static int dayKey(int offsetDays) {
        Calendar c = Calendar.getInstance();
        c.add(Calendar.DAY_OF_YEAR, offsetDays);
        return c.get(Calendar.YEAR) * 10000 + (c.get(Calendar.MONTH) + 1) * 100
                + c.get(Calendar.DAY_OF_MONTH);
    }

    private static String todayStr() {
        Calendar c = Calendar.getInstance();
        return String.format(Locale.US, "%d年%d月%d日",
                c.get(Calendar.YEAR), c.get(Calendar.MONTH) + 1, c.get(Calendar.DAY_OF_MONTH));
    }

    static void recordDismiss(Context c, int alarmHour, boolean quiz) {
        SharedPreferences p = sp(c);
        int today = dayKey(0);
        SharedPreferences.Editor e = p.edit();

        if (alarmHour < EARLY_HOUR && p.getInt("earlyLast", 0) != today) {
            e.putInt("earlyDays", p.getInt("earlyDays", 0) + 1);
            e.putInt("earlyLast", today);
            int last = p.getInt("lastDay", 0);
            int streak = p.getInt("streak", 0);
            streak = (last == dayKey(-1)) ? streak + 1 : 1;
            e.putInt("streak", streak);
            e.putInt("best", Math.max(p.getInt("best", 0), streak));
            e.putInt("lastDay", today);
        }

        if (quiz) e.putInt("quizOk", p.getInt("quizOk", 0) + 1);
        e.apply();
        badges(c);
    }
    static void recordBedtime(Context c) {
        SharedPreferences p = sp(c);
        int today = dayKey(0);
        if (p.getInt("bedLast", 0) == today) return;
        p.edit().putInt("bedDays", p.getInt("bedDays", 0) + 1)
                .putInt("bedLast", today).apply();
    }

    static void recordWrong(Context c) {
        SharedPreferences p = sp(c);
        p.edit().putInt("quizWrong", p.getInt("quizWrong", 0) + 1).apply();
    }

    static int score(Context c) {
        SharedPreferences p = sp(c);
        return p.getInt("earlyDays", 0) + p.getInt("bedDays", 0);
    }

    static int todayPoints(Context c) {
        SharedPreferences p = sp(c);
        int today = dayKey(0);
        return (p.getInt("earlyLast", 0) == today ? 1 : 0)
                + (p.getInt("bedLast", 0) == today ? 1 : 0);
    }

    static int earlyDays(Context c) { return sp(c).getInt("earlyDays", 0); }
    static int quizOk(Context c) { return sp(c).getInt("quizOk", 0); }
    static int best(Context c) { return sp(c).getInt("best", 0); }

    static final class Badge {
        final String key, name, desc, dateText;
        final int tier, style;
        final boolean got;

        Badge(String key, int tier, int style, String name, String desc, boolean got, String dateText) {
            this.key = key;
            this.tier = tier;
            this.style = style;
            this.name = name;
            this.desc = desc;
            this.got = got;
            this.dateText = dateText;
        }
    }
    static Badge[] badges(Context c) {
        int w = earlyDays(c), q = quizOk(c), b = best(c);
        SharedPreferences p = sp(c);
        SharedPreferences.Editor ed = p.edit();
        String now = todayStr();
        boolean dirty = false;

        Object[][] defs = {
            // 青铜阶 (1 ~ 4 阶)
            {"w1",   BadgeView.TIER_BRONZE, 1,  "初见晨光", "首次在 8:00 前成功起床", w >= 1},
            {"w7",   BadgeView.TIER_BRONZE, 2,  "晨光新手", "累计早起 7 天", w >= 7},
            {"s3",   BadgeView.TIER_BRONZE, 3,  "三天连续", "连续 3 天 8:00 前早起", b >= 3},
            {"q5",   BadgeView.TIER_BRONZE, 4,  "清醒初试", "累计答对 5 道唤醒题", q >= 5},

            // 白银阶 (5 ~ 8 阶)
            {"w30",  BadgeView.TIER_SILVER, 5,  "早起达人", "累计早起 30 天", w >= 30},
            {"w50",  BadgeView.TIER_SILVER, 6,  "晨光进阶", "累计早起 50 天", w >= 50},
            {"s7",   BadgeView.TIER_SILVER, 7,  "七天连续", "连续 7 天 8:00 前早起", b >= 7},
            {"q30",  BadgeView.TIER_SILVER, 8,  "最强大脑", "累计答对 30 道唤醒题", q >= 30},

            // 黄金战神阶 (9 ~ 12 阶)
            {"w100", BadgeView.TIER_GOLD,   9,  "百日晨星", "累计早起 100 天", w >= 100},
            {"s30",  BadgeView.TIER_GOLD,   10, "月度全勤", "连续 30 天 8:00 前早起", b >= 30},
            {"q100", BadgeView.TIER_GOLD,   11, "算无遗策", "累计答对 100 道唤醒题", q >= 100},
            {"w365", BadgeView.TIER_GOLD,   12, "星光旅者", "累计早起 365 天", w >= 365}
        };

        Badge[] out = new Badge[defs.length];
        for (int i = 0; i < defs.length; i++) {
            String k = (String) defs[i][0];
            int tier = (Integer) defs[i][1];
            int rankStyle = (Integer) defs[i][2];
            String name = (String) defs[i][3];
            String desc = (String) defs[i][4];
            boolean got = (Boolean) defs[i][5];
            String dKey = "date_" + k;
            String dateStr = p.getString(dKey, "");
            if (got && dateStr.isEmpty()) {
                dateStr = now;
                ed.putString(dKey, dateStr);
                dirty = true;
            }
            out[i] = new Badge(k, tier, rankStyle, name, desc, got, dateStr);
        }
        if (dirty) ed.apply();
        return out;
    }

    static List<Badge> popNewlyUnlocked(Context c) {
        Badge[] all = badges(c);
        SharedPreferences p = sp(c);
        SharedPreferences.Editor ed = p.edit();
        List<Badge> newly = new ArrayList<Badge>();
        for (Badge b : all) {
            if (b.got && !p.getBoolean("shown_" + b.key, false)) {
                ed.putBoolean("shown_" + b.key, true);
                newly.add(b);
            }
        }
        if (!newly.isEmpty()) ed.apply();
        return newly;
    }
}
