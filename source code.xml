package com.alarm.application;

import java.util.Calendar;
import java.util.Locale;

final class TimeText {
    static String period(int hour) {
        return hour < 5 ? "凌晨" : hour < 12 ? "上午" : hour < 18 ? "下午" : "晚上";
    }

    static String hms(Alarm a) {
        if (a.second > 0) {
            return String.format(Locale.US, "%02d:%02d:%02d", a.hour, a.minute, a.second);
        }
        return String.format(Locale.US, "%02d:%02d", a.hour, a.minute);
    }

    static String clock(long ms) {
        Calendar c = Calendar.getInstance();
        c.setTimeInMillis(ms);
        int h = c.get(Calendar.HOUR_OF_DAY);
        int m = c.get(Calendar.MINUTE);
        int s = c.get(Calendar.SECOND);
        if (s > 0) return String.format(Locale.US, "%02d:%02d:%02d", h, m, s);
        return String.format(Locale.US, "%02d:%02d", h, m);
    }

    static void zero(Calendar c) {
        c.set(Calendar.HOUR_OF_DAY, 0);
        c.set(Calendar.MINUTE, 0);
        c.set(Calendar.SECOND, 0);
        c.set(Calendar.MILLISECOND, 0);
    }

    static String dayLabel(long ms) {
        Calendar t = Calendar.getInstance();
        t.setTimeInMillis(ms);
        Calendar n = Calendar.getInstance();
        zero(t);
        zero(n);
        long diff = Math.round((t.getTimeInMillis() - n.getTimeInMillis()) / 86400000.0);
        if (diff <= 0) return "今天";
        if (diff == 1) return "明天";
        return Alarm.DN[t.get(Calendar.DAY_OF_WEEK) - 1];
    }

    static String until(long ms) {
        long secs = Math.max(0, (ms - System.currentTimeMillis()) / 1000);
        long d = secs / 86400;
        long hh = (secs % 86400) / 3600;
        long m = (secs % 3600) / 60;
        long s = secs % 60;
        StringBuilder sb = new StringBuilder();
        if (d > 0) sb.append(d).append(" 天 ");
        if (hh > 0) sb.append(hh).append(" 小时 ");
        if (m > 0) sb.append(m).append(" 分钟 ");
        if (secs < 600 && (s > 0 || sb.length() == 0)) sb.append(s).append(" 秒");
        return sb.toString().trim();
    }
}
