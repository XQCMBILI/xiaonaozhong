package com.alarm.application;

import android.content.Context;
import android.content.SharedPreferences;

import org.json.JSONArray;

import java.util.ArrayList;
import java.util.Collections;
import java.util.Comparator;
import java.util.List;

final class AlarmStore {
    private static SharedPreferences sp(Context c) {
        return c.getSharedPreferences("alarms", Context.MODE_PRIVATE);
    }

    static List<Alarm> all(Context c) {
        List<Alarm> l = new ArrayList<Alarm>();
        try {
            JSONArray arr = new JSONArray(sp(c).getString("list", "[]"));
            for (int i = 0; i < arr.length(); i++) {
                l.add(Alarm.fromJson(arr.getJSONObject(i)));
            }
        } catch (Exception ignored) {
        }
        Collections.sort(l, new Comparator<Alarm>() {
            @Override
            public int compare(Alarm x, Alarm y) {
                return x.hour != y.hour ? x.hour - y.hour : x.minute - y.minute;
            }
        });
        return l;
    }

    static Alarm get(Context c, int id) {
        for (Alarm a : all(c)) {
            if (a.id == id) return a;
        }
        return null;
    }

    static int nextId(Context c) {
        int id = sp(c).getInt("nextId", 1);
        sp(c).edit().putInt("nextId", id + 1).apply();
        return id;
    }

    private static void save(Context c, List<Alarm> l) {
        JSONArray arr = new JSONArray();
        for (Alarm a : l) arr.put(a.toJson());
        sp(c).edit().putString("list", arr.toString()).apply();
    }

    static void upsert(Context c, Alarm a) {
        List<Alarm> l = all(c);
        boolean found = false;
        for (int i = 0; i < l.size(); i++) {
            if (l.get(i).id == a.id) {
                l.set(i, a);
                found = true;
                break;
            }
        }
        if (!found) l.add(a);
        save(c, l);
    }

    static void delete(Context c, int id) {
        List<Alarm> l = all(c);
        for (int i = l.size() - 1; i >= 0; i--) {
            if (l.get(i).id == id) l.remove(i);
        }
        save(c, l);
    }
}
