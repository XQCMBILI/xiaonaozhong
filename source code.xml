        }
        Window w = getWindow();
        w.addFlags(WindowManager.LayoutParams.FLAG_SHOW_WHEN_LOCKED
                | WindowManager.LayoutParams.FLAG_TURN_SCREEN_ON
                | WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON
                | WindowManager.LayoutParams.FLAG_DISMISS_KEYGUARD
                | WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS);
        w.setStatusBarColor(android.graphics.Color.TRANSPARENT);
        w.setNavigationBarColor(android.graphics.Color.TRANSPARENT);

        WindowManager.LayoutParams wlp = w.getAttributes();
        if (Build.VERSION.SDK_INT >= 28) {
            wlp.layoutInDisplayCutoutMode =
                    WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES;
        }
        if (currentAlarm.dawn) wlp.screenBrightness = 0.01f;
        w.setAttributes(wlp);
        applyImmersive();
        if (currentAlarm.dawn) {
            final WindowManager.LayoutParams lp = w.getAttributes();
            long duration = currentAlarm.gradual ? Math.max(1, currentAlarm.rampSec) * 1000L : 30000L;
            android.animation.ValueAnimator anim = android.animation.ValueAnimator.ofFloat(0.01f, 1.0f);
            anim.setDuration(duration);
            anim.addUpdateListener(new android.animation.ValueAnimator.AnimatorUpdateListener() {
                @Override
                public void onAnimationUpdate(android.animation.ValueAnimator animation) {
                    lp.screenBrightness = (float) animation.getAnimatedValue();
                    getWindow().setAttributes(lp);
                }
            });
            anim.start();
        }

        FrameLayout frame = new FrameLayout(this);
        frame.setBackgroundColor(Ui.bg);

        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setGravity(Gravity.CENTER_HORIZONTAL);
        root.setPadding(dp(24), dp(48), dp(24), dp(32));

        TextView label = Ui.tv(this, currentAlarm.label.isEmpty() ? "闹钟" : currentAlarm.label,
                26, Ui.primary, "sans-serif-medium");
        label.setPadding(0, 0, 0, dp(12));
        root.addView(label);

        if (currentAlarm.forceLevel > 0) {
            buildQuiz(root);
        } else {
            buildNormal(root, id);
        }
        frame.addView(root, new FrameLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
        setContentView(frame);
    }

    private void buildQuiz(LinearLayout root) {
        currentQ = QuestionBank.pick(currentAlarm.forceLevel);

        LinearLayout qBox = new LinearLayout(this);
        qBox.setOrientation(LinearLayout.VERTICAL);
        qBox.setGravity(Gravity.CENTER_HORIZONTAL);
        qBox.setBackground(Ui.shape(this, Ui.surface, 32));
        qBox.setPadding(dp(16), dp(20), dp(16), dp(16));

        final String lvlText = currentAlarm.forceLevel == 1 ? "级别 A"
                : (currentAlarm.forceLevel == 2 ? "级别 B" : "级别 C");
        final TextView qTitle = Ui.tv(this, "唤醒验证 · " + currentQ.type + " (" + lvlText + ")",
                14, Ui.textVar, "sans-serif-medium");
        qTitle.setGravity(Gravity.CENTER);
        qBox.addView(qTitle, new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));

        final TextView qText = Ui.tv(this, currentQ.content, 24, Ui.text, "sans-serif-medium");
        qText.setGravity(Gravity.CENTER);
        LinearLayout.LayoutParams tp = new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, dp(96));
        tp.topMargin = dp(8);
        qBox.addView(qText, tp);

        final TextView qInput = Ui.tv(this, "", 34, Ui.primary, "sans-serif-medium");
        qInput.setGravity(Gravity.CENTER);
        qInput.setBackground(Ui.shape(this, Ui.bg, 22));
        qBox.addView(qInput, new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, dp(64)));
        LinearLayout numpad = new LinearLayout(this);
        numpad.setOrientation(LinearLayout.VERTICAL);
        String[][] keys = {{"1", "2", "3"}, {"4", "5", "6"}, {"7", "8", "9"}, {"清除", "0", "删除"}};
        for (String[] rowKeys : keys) {
            LinearLayout row = new LinearLayout(this);
            row.setOrientation(LinearLayout.HORIZONTAL);
            for (final String k : rowKeys) {
                TextView btn = Ui.tv(this, k, 21, Ui.text, "sans-serif-medium");
                btn.setGravity(Gravity.CENTER);
                btn.setBackground(Ui.shape(this, Ui.bg, 18));
                LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(0, dp(54), 1f);
                p.setMargins(dp(5), dp(5), dp(5), dp(5));
                row.addView(btn, p);
                btn.setOnTouchListener(new View.OnTouchListener() {
                    @Override
                    public boolean onTouch(View v, MotionEvent event) {
                        int a = event.getAction();
                        if (a == MotionEvent.ACTION_DOWN) {
                            v.animate().scaleX(0.9f).scaleY(0.9f).setDuration(40).start();
                            v.performHapticFeedback(android.view.HapticFeedbackConstants.KEYBOARD_TAP,
                                    android.view.HapticFeedbackConstants.FLAG_IGNORE_GLOBAL_SETTING);
                            String s = qInput.getText().toString();
                            if (k.equals("清除")) {
                                qInput.setText("");
                            } else if (k.equals("删除")) {
                                if (s.length() > 0) qInput.setText(s.substring(0, s.length() - 1));
                            } else if (s.length() < 6) {
                                qInput.setText(s + k);
                            }
                            return true;
                        } else if (a == MotionEvent.ACTION_UP || a == MotionEvent.ACTION_CANCEL) {
                            v.animate().scaleX(1f).scaleY(1f).setDuration(60).start();
                            return true;
                        }
                        return false;
                    }
                });
            }
            numpad.addView(row, new LinearLayout.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
        }
        LinearLayout.LayoutParams np = new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        np.topMargin = dp(12);
        qBox.addView(numpad, np);

        ScrollView sv = new ScrollView(this);
        sv.setOverScrollMode(View.OVER_SCROLL_NEVER);
        sv.setFillViewport(false);
        sv.addView(qBox, new ViewGroup.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
        root.addView(sv, new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f));

        TextView verifyBtn = Ui.tv(this, "确认并关闭闹钟", 18, Ui.onPrimary, "sans-serif-medium");
        verifyBtn.setGravity(Gravity.CENTER);
        verifyBtn.setBackground(Ui.ripple(Ui.shape(this, Ui.primary, 100)));
        LinearLayout.LayoutParams vp = new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, dp(64));
        vp.topMargin = dp(16);
        root.addView(verifyBtn, vp);

        verifyBtn.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                try {
                    int ans = Integer.parseInt(qInput.getText().toString().trim());
                    if (ans == currentQ.answer) {
                        Stats.recordDismiss(RingActivity.this, currentAlarm.hour, true);
                        AlarmReceiver.dismiss(RingActivity.this);
                        finishWithBadgeCheck();
                    } else {
                        Stats.recordWrong(RingActivity.this);
                        qInput.setText("");
                        currentQ = QuestionBank.pick(currentAlarm.forceLevel);
                        qText.setText(currentQ.content);
                        qTitle.setTextColor(Ui.error);
                        qTitle.setText("验证未通过，已切换新题 · " + currentQ.type);
                    }
                } catch (Exception e) {
                    qTitle.setTextColor(Ui.error);
                    qTitle.setText("请输入有效整数");
                }
            }
        });
    }
    private void buildNormal(LinearLayout root, final int id) {
        FrameLayout stage = new FrameLayout(this);
        MorphLoadingView mv = new MorphLoadingView(this);
        mv.setContained(false, 0);
        mv.setPalette(new int[]{
                Ui.dark ? 0xFF8E4FB8 : 0xFFD9B3F2,
                Ui.dark ? 0xFF8A4A2E : 0xFFFFC2A8,
                Ui.dark ? 0xFF2F7A52 : 0xFFA6E3B3,
                Ui.dark ? 0xFF3D5F9E : 0xFFB6D6FF});
        stage.addView(mv, new FrameLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
        TextView time = Ui.tv(this, TimeText.hms(currentAlarm),
                currentAlarm.second > 0 ? 44 : 60, Ui.text, "sans-serif-light");
        stage.addView(time, new FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT,
                ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.CENTER));
        LinearLayout.LayoutParams sp = new LinearLayout.LayoutParams(dp(300), dp(300));
        sp.topMargin = dp(32);
        root.addView(stage, sp);

        root.addView(new View(this), new LinearLayout.LayoutParams(1, 0, 1f));

        LinearLayout btns = new LinearLayout(this);
        btns.setOrientation(LinearLayout.HORIZONTAL);
        TextView snooze = Ui.tv(this, "稍后 " + currentAlarm.snoozeMin + " 分钟", 18,
                Ui.onTertiaryC, "sans-serif-medium");
        snooze.setGravity(Gravity.CENTER);
        snooze.setBackground(Ui.ripple(Ui.shape(this, Ui.tertiaryC, 100)));
        TextView stop = Ui.tv(this, "关闭", 18, Ui.onPrimary, "sans-serif-medium");
        stop.setGravity(Gravity.CENTER);
        stop.setBackground(Ui.ripple(Ui.shape(this, Ui.primary, 100)));
        LinearLayout.LayoutParams p1 = new LinearLayout.LayoutParams(0, dp(64), 1f);
        p1.rightMargin = dp(12);
        btns.addView(snooze, p1);
        btns.addView(stop, new LinearLayout.LayoutParams(0, dp(64), 1.3f));
        root.addView(btns, new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));

        snooze.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                AlarmReceiver.snooze(RingActivity.this, id);
                finish();
            }
        });
        stop.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                Stats.recordDismiss(RingActivity.this, currentAlarm.hour, false);
                AlarmReceiver.dismiss(RingActivity.this);
                finishWithBadgeCheck();
            }
        });
    }

    private void finishWithBadgeCheck() {
        java.util.List<Stats.Badge> newly = Stats.popNewlyUnlocked(this);
        if (!newly.isEmpty()) {
            celebrating = true;
            cur = null;
            BadgeView.showCelebration(this, newly.get(0), new Runnable() {
                @Override
                public void run() {
                    finish();
                }
            });
        } else {
            finish();
        }
    }
    private void enforceLock() {
        if (!celebrating && currentAlarm != null && currentAlarm.forceLevel > 0 && !isFinishing()) {
            try {
                android.app.ActivityManager am =
                        (android.app.ActivityManager) getSystemService(Context.ACTIVITY_SERVICE);
                if (am != null) am.moveTaskToFront(getTaskId(), 0);
            } catch (Exception ignored) {
            }
            android.content.Intent i = new android.content.Intent(this, RingActivity.class);
            i.putExtra("id", currentAlarm.id);
            i.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK
                    | android.content.Intent.FLAG_ACTIVITY_SINGLE_TOP
                    | android.content.Intent.FLAG_ACTIVITY_NO_ANIMATION);
            startActivity(i);
            overridePendingTransition(0, 0);
        }
    }

    @Override
    protected void onResume() {
        super.onResume();
        applyImmersive();
    }

    @Override
    public void onWindowFocusChanged(boolean hasFocus) {
        super.onWindowFocusChanged(hasFocus);
        if (hasFocus) applyImmersive();
    }

    @Override
    public void onBackPressed() {
    }

    @Override
    protected void onUserLeaveHint() {
        super.onUserLeaveHint();
        enforceLock();
    }

    @Override
    protected void onDestroy() {
        if (cur == this) cur = null;
        super.onDestroy();
    }
}
