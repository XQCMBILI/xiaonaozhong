package com.alarm.application;

import android.content.Context;
import android.graphics.Canvas;
import android.graphics.Paint;
import android.graphics.Typeface;
import android.graphics.drawable.GradientDrawable;
import android.os.SystemClock;
import android.view.Gravity;
import android.view.View;
import android.widget.LinearLayout;
import android.widget.TextView;

/** 进入「我的」时的开场动画：上面的文字向右滑，下面的文字向左滑。 */
final class IntroView extends LinearLayout {
    private static final String[] WORDS = {
            "慢慢来，比较快", "今天也辛苦啦", "愿你被温柔以待", "早安，世界很可爱",
            "好好睡觉，好好醒来", "你已经很棒了", "每一次起床都值得夸奖",
            "时间会偏爱认真的人", "天亮了，一切都会好起来", "给自己一个拥抱"
    };

    private final LinearLayout center;

    IntroView(Context c) {
        super(c);
        setOrientation(VERTICAL);
        setGravity(Gravity.CENTER);
        setClickable(true);
        // 核心修复：强制使用 255 完全不透明的颜色，防止开启流体渐变时透出底下的页面造成重叠
        int topColor = Tones.alpha(Ui.primaryC, 255);
        int botColor = Tones.alpha(Ui.bg, 255);
        setBackground(new GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,
                new int[]{topColor, botColor}));

        // 上面两行：向右滑
        addRow(c, 0, +1, 30, 0x40, 28, 0);
        addRow(c, 3, +1, 20, 0x77, 52, 90);

        center = new LinearLayout(c);
        center.setOrientation(VERTICAL);
        center.setGravity(Gravity.CENTER);
        center.setPadding(Ui.dp(c, 20), 0, Ui.dp(c, 20), 0);

        // 核心修改：替换为 Wake with Purpose. 与 醒来，奔赴所想。
        TextView t = Ui.tv(c, "Wake with Purpose.", 32, Ui.primary, "sans-serif-medium");
        t.setTypeface(Typeface.create("sans-serif-medium", Typeface.BOLD));
        t.setGravity(Gravity.CENTER);
        center.addView(t);

        TextView s = Ui.tv(c, "醒来，奔赴所想。", 16, Ui.textVar, "sans-serif-medium");
        s.setGravity(Gravity.CENTER);
        s.setPadding(0, Ui.dp(c, 12), 0, 0);
        center.addView(s);

        center.setAlpha(0f);
        center.setScaleX(0.92f);
        center.setScaleY(0.92f);
        LayoutParams cp = new LayoutParams(Widgets.MATCH, Widgets.WRAP);
        cp.topMargin = Ui.dp(c, 36);
        cp.bottomMargin = Ui.dp(c, 36);
        addView(center, cp);

        // 下面两行：向左滑
        addRow(c, 6, -1, 20, 0x77, 52, 40);
        addRow(c, 8, -1, 30, 0x40, 28, 160);
    }
    private void addRow(Context c, int start, int dir, float textDp, int alpha,
                        float speedDp, float phaseDp) {
        MarqueeRow r = new MarqueeRow(c, start, dir, textDp, alpha, speedDp, phaseDp);
        addView(r, new LayoutParams(Widgets.MATCH, Ui.dp(c, textDp + 28)));
    }

    @Override
    protected void onAttachedToWindow() {
        super.onAttachedToWindow();
        center.animate().alpha(1f).scaleX(1f).scaleY(1f)
                .setStartDelay(200).setDuration(650).start();
    }

    private static final class MarqueeRow extends View {
        private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
        private final String unit;
        private final int dir;
        private final float speed;
        private final float phase;
        private final float unitW;
        private final long t0 = SystemClock.uptimeMillis();

        MarqueeRow(Context c, int start, int dir, float textDp, int alpha,
                   float speedDp, float phaseDp) {
            super(c);
            float d = c.getResources().getDisplayMetrics().density;
            this.dir = dir;
            this.speed = speedDp * d;
            this.phase = phaseDp * d;
            p.setTextSize(textDp * d);
            p.setTypeface(Typeface.create("sans-serif-medium", Typeface.NORMAL));
            p.setColor(Ui.primary);
            p.setAlpha(alpha);
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < WORDS.length; i++) {
                sb.append(WORDS[(start + i) % WORDS.length]).append("      ·      ");
            }
            unit = sb.toString();
            unitW = p.measureText(unit);
        }

        @Override
        protected void onDraw(Canvas canvas) {
            if (unitW <= 0) return;
            float t = (SystemClock.uptimeMillis() - t0) / 1000f;
            float x = (phase + t * speed * dir) % unitW;
            if (x > 0) x -= unitW;
            float base = getHeight() / 2f - (p.ascent() + p.descent()) / 2f;
            while (x < getWidth()) {
                canvas.drawText(unit, x, base, p);
                x += unitW;
            }
            postInvalidateOnAnimation();
        }
    }
}
