package com.alarm.application;

import android.animation.ArgbEvaluator;
import android.content.Context;
import android.graphics.Canvas;
import android.graphics.Paint;
import android.graphics.Path;
import android.os.SystemClock;
import android.view.View;
import android.view.animation.OvershootInterpolator;

public class MorphLoadingView extends View {
    private static final int N = Shapes.N;

    private int stepMs = 560;
    private final long startMs = SystemClock.uptimeMillis();

    private final float[][] shapes = Shapes.build();
    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
    private final Path path = new Path();
    private final ArgbEvaluator ev = new ArgbEvaluator();
    private final OvershootInterpolator spring = new OvershootInterpolator(1.75f);
    private int[] palette;
    // 默认关闭丑陋的外圈大圆底盘，保持与录屏一致的纯净单图形
    private boolean contained = false;
    private int containerColor;

    public MorphLoadingView(Context c) {
        super(c);
        Ui.init(c);
        containerColor = Ui.primaryC;
        int tone = Tones.hsl(Tones.hueOf(Theme.seed), 0.72f, Ui.dark ? 0.78f : 0.56f);
        palette = new int[]{tone};
    }

    public void setAnimationSpeed(int ms) {
        this.stepMs = Math.max(320, ms);
    }

    public void setPalette(int[] colors) {
        palette = colors;
        invalidate();
    }

    public void setContained(boolean contained, int containerColor) {
        this.contained = contained;
        this.containerColor = containerColor;
        invalidate();
    }
    @Override
    protected void onDraw(Canvas canvas) {
        float w = getWidth();
        float h = getHeight();
        if (w <= 0 || h <= 0) return;
        float cx = w / 2f;
        float cy = h / 2f;
        float R = Math.min(w, h) / 2f;

        if (contained) {
            paint.setColor(containerColor);
            canvas.drawCircle(cx, cy, R, paint);
        }

        float elapsed = (float) (SystemClock.uptimeMillis() - startMs);
        float v = elapsed / stepMs;
        int base = (int) Math.floor(v);
        float f = v - base;

        int k = base % shapes.length;
        int k1 = (k + 1) % shapes.length;
        // 还原 Google Play 节奏：前 20% 停顿展示当前图形，后 80% 弹簧果冻变形到下一图形
        float e = f < 0.20f ? 0f : spring.getInterpolation((f - 0.20f) / 0.80f);

        int c0 = palette[k % palette.length];
        int c1 = palette[(k + 1) % palette.length];
        paint.setColor((Integer) ev.evaluate(f, c0, c1));

        float s = contained ? R * 0.58f : R * 0.84f;
        double rot = (base + e) * (2.0 * Math.PI / shapes.length);
        float[] a = shapes[k];
        float[] b = shapes[k1];
        path.reset();
        for (int i = 0; i < N; i++) {
            float r = (a[i] + (b[i] - a[i]) * e) * s;
            double th = i * 2 * Math.PI / N + rot;
            float x = cx + (float) (r * Math.cos(th));
            float y = cy + (float) (r * Math.sin(th));
            if (i == 0) path.moveTo(x, y);
            else path.lineTo(x, y);
        }
        path.close();
        canvas.drawPath(path, paint);

        postInvalidateOnAnimation();
    }
}
