package com.alarm.application;

import android.content.BroadcastReceiver;
import android.content.Context;
import android.content.Intent;
import android.os.Build;

public class AlarmReceiver extends BroadcastReceiver {
    // 这里的广播动作必须使用小闹钟的包名
    static final String RING = "com.alarm.application.ALARM";
    static final String DISMISS = "com.alarm.application.DISMISS";
    static final String SNOOZE = "com.alarm.application.SNOOZE";

    @Override
    public void onReceive(Context c, Intent in) {
        String act = in.getAction();
        int id = in.getIntExtra("id", -1);
        if (DISMISS.equals(act)) {
            dismiss(c);
            return;
        }
        if (SNOOZE.equals(act)) {
            snooze(c, id);
            return;
        }

        Alarm a = AlarmStore.get(c, id);
        if (a == null) return;
        if (!in.getBooleanExtra("snooze", false)) {
            if (a.days == 0) {
                a.enabled = false;
                AlarmStore.upsert(c, a);
            } else {
                AlarmScheduler.schedule(c, a);
            }
        }
        Intent s = new Intent(c, AlarmService.class).putExtra("id", id);
        if (Build.VERSION.SDK_INT >= 26) {
            c.startForegroundService(s);
        } else {
            c.startService(s);
        }
    }

    static void dismiss(Context c) {
        c.stopService(new Intent(c, AlarmService.class));
    }

    static void snooze(Context c, int id) {
        c.stopService(new Intent(c, AlarmService.class));
        Alarm a = AlarmStore.get(c, id);
        if (a != null) AlarmScheduler.snooze(c, a);
    }
}
