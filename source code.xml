package com.alarm.application;

import android.content.Context;
import android.media.AudioAttributes;
import android.media.MediaPlayer;
import android.media.RingtoneManager;
import android.net.Uri;
import android.os.Build;
import android.os.Handler;
import android.os.Looper;
import android.os.SystemClock;
import android.os.VibrationEffect;
import android.os.Vibrator;
import android.os.VibratorManager;

final class AlarmSound {
    private final Context ctx;
    private final Handler h = new Handler(Looper.getMainLooper());
    private MediaPlayer mp;
    private Vibrator vib;
    private Alarm alarm;
    private boolean vibrating = false;

    // 守护脉冲：每 1.2 秒主动激发一次，彻底防止被系统锁屏拦截或被按键震动打断
    private final Runnable vibLoop = new Runnable() {
        @Override
        public void run() {
            if (!vibrating || vib == null) return;
            triggerVibratePulse();
            h.postDelayed(this, 1200);
        }
    };

    AlarmSound(Context c) {
        ctx = c;
    }

    void start(Alarm a) {
        alarm = a;
        if (a.ringtone != null && a.ringtone.length() > 0) mp = tryPlayer(Uri.parse(a.ringtone));
        if (mp == null) mp = tryPlayer(RingtoneManager.getDefaultUri(RingtoneManager.TYPE_ALARM));
        if (mp == null) mp = tryPlayer(RingtoneManager.getDefaultUri(RingtoneManager.TYPE_RINGTONE));
        if (mp != null && a.gradual) startRamp();
        if (a.vibrate) startVibrate();
    }

    private MediaPlayer tryPlayer(Uri u) {
        if (u == null) return null;
        try {
            MediaPlayer m = new MediaPlayer();
            m.setAudioAttributes(new AudioAttributes.Builder()
                    .setUsage(AudioAttributes.USAGE_ALARM)
                    .setContentType(AudioAttributes.CONTENT_TYPE_MUSIC).build());
            m.setDataSource(ctx, u);
            m.setLooping(true);
            m.prepare();
            float v0 = alarm.gradual ? 0.03f : 1f;
            m.setVolume(v0, v0);
            m.start();
            return m;
        } catch (Exception e) {
            return null;
        }
    }

    private void startRamp() {
        final long t0 = SystemClock.uptimeMillis();
        final float total = Math.max(1, alarm.rampSec) * 1000f;
        h.post(new Runnable() {
            @Override
            public void run() {
                if (mp == null) return;
                float f = Math.min(1f, (SystemClock.uptimeMillis() - t0) / total);
                float v = Math.max(0.03f, f * f);
                try {
                    mp.setVolume(v, v);
                } catch (Exception ignored) {
                }
                if (f < 1f) h.postDelayed(this, 100);
            }
        });
    }

    private void startVibrate() {
        try {
            if (Build.VERSION.SDK_INT >= 31) {
                VibratorManager vm = (VibratorManager) ctx.getSystemService(Context.VIBRATOR_MANAGER_SERVICE);
                if (vm != null) vib = vm.getDefaultVibrator();
            }
            if (vib == null) {
                vib = (Vibrator) ctx.getSystemService(Context.VIBRATOR_SERVICE);
            }
        } catch (Throwable ignored) {
        }
        if (vib == null || !vib.hasVibrator()) return;
        vibrating = true;
        h.removeCallbacks(vibLoop);
        h.post(vibLoop);
    }

    private void triggerVibratePulse() {
        try {
            // 核心修复：声明 USAGE_ALARM 闹钟最高特权，突破静音、勿扰模式与后台限制
            AudioAttributes attrs = new AudioAttributes.Builder()
                    .setUsage(AudioAttributes.USAGE_ALARM)
                    .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)
                    .build();
            if (Build.VERSION.SDK_INT >= 26) {
                vib.vibrate(VibrationEffect.createOneShot(750, VibrationEffect.DEFAULT_AMPLITUDE), attrs);
            } else if (Build.VERSION.SDK_INT >= 21) {
                vib.vibrate(750, attrs);
            } else {
                vib.vibrate(750);
            }
        } catch (Throwable ignored) {
        }
    }

    void stop() {
        vibrating = false;
        h.removeCallbacksAndMessages(null);
        if (mp != null) {
            try {
                mp.stop();
            } catch (Exception ignored) {
            }
            mp.release();
            mp = null;
        }
        if (vib != null) {
            try {
                vib.cancel();
            } catch (Throwable ignored) {
            }
            vib = null;
        }
    }
}
</file>

