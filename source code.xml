        box.addView(Widgets.switchRow(c, "震动", "响铃时同时震动",
                d.vibrate, new Widgets.BoolCb() {
                    @Override
                    public void on(boolean on) { d.vibrate = on; }
                }), vp);

        LinearLayout.LayoutParams dp = new LinearLayout.LayoutParams(Widgets.MATCH, Widgets.WRAP);
        dp.topMargin = Ui.dp(c, 10);
        box.addView(Widgets.switchRow(c, "晨光唤醒", "屏幕亮度将从极暗逐渐变亮",
                d.dawn, new Widgets.BoolCb() {
                    @Override
                    public void on(boolean on) { d.dawn = on; }
                }), dp);

        box.addView(Widgets.sectionLabel(c, "唤醒验证"));
        final LinearLayout forceBox = new LinearLayout(c);
        forceBox.setOrientation(LinearLayout.VERTICAL);
        TextView fl = Ui.tv(c, "验证难度", 13, Ui.textVar, "sans-serif-medium");
        fl.setPadding(Ui.dp(c, 4), Ui.dp(c, 12), 0, Ui.dp(c, 8));
        forceBox.addView(fl);

        final String[] diffNames = {"简单 (A)", "中等 (B)", "困难 (C)"};
        int initDiff = d.forceLevel > 0 ? d.forceLevel - 1 : 0;
        final LinearLayout diffRow = Widgets.chipRow(c, diffNames, initDiff, new Widgets.IntCb() {
            @Override
            public void on(int i) {
                d.forceLevel = i + 1;
            }
        });
        forceBox.addView(diffRow);
        forceBox.setVisibility(d.forceLevel > 0 ? View.VISIBLE : View.GONE);

        box.addView(Widgets.switchRow(c, "强制唤醒", "响铃时需完成逻辑与计算验证方可关闭闹钟",
                d.forceLevel > 0, new Widgets.BoolCb() {
                    @Override
                    public void on(boolean on) {
                        if (on) {
                            if (d.forceLevel == 0) d.forceLevel = 1;
                            forceBox.setVisibility(View.VISIBLE);
                        } else {
                            d.forceLevel = 0;
                            forceBox.setVisibility(View.GONE);
                        }
                    }
                }));
        box.addView(forceBox);

        box.addView(Widgets.sectionLabel(c, "稍后提醒间隔"));
        int si = 0;
        for (int i = 0; i < SNOOZE.length; i++) {
            if (SNOOZE[i] == d.snoozeMin) si = i;
        }
        String[] snoozeNames = {"5 分钟", "10 分钟", "15 分钟"};
        box.addView(Widgets.chipRow(c, snoozeNames, si, new Widgets.IntCb() {
            @Override
            public void on(int i) { d.snoozeMin = SNOOZE[i]; }
        }));
    }
}
