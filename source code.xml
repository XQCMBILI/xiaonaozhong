        List<Q> bag;
        Q[] source;
        if (requestedLevel == 1) {
            bag = BAG_A;
            source = LEVEL_A;
        } else if (requestedLevel == 2) {
            bag = BAG_B;
            source = LEVEL_B;
        } else {
            bag = BAG_C;
            source = LEVEL_C;
        }

        if (bag.isEmpty()) {
            Collections.addAll(bag, source);
            Collections.shuffle(bag, R);
            // 防止新一轮洗牌的第一题与上一轮最后一题撞车
            if (bag.size() > 1 && bag.get(0).id == lastId) {
                Q first = bag.remove(0);
                bag.add(first);
            }
        }

        Q picked = bag.remove(0);
        lastId = picked.id;
        return picked;
    }
