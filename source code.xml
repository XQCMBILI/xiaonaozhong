package com.alarm.application;

import android.content.Context;
import android.view.Gravity;
import android.view.View;
import android.widget.FrameLayout;

final class GlowWrap {
    static FrameLayout wrap(Context c, View content, CloudGlow glow, int marginDp) {
        FrameLayout f = new FrameLayout(c);
        f.setClipChildren(false);
        f.addView(glow, new FrameLayout.LayoutParams(Widgets.MATCH, Widgets.MATCH));
        FrameLayout.LayoutParams p = new FrameLayout.LayoutParams(
                Widgets.WRAP, Widgets.WRAP, Gravity.CENTER);
        p.setMargins(Ui.dp(c, marginDp), 0, Ui.dp(c, marginDp), 0);
        f.addView(content, p);
        return f;
    }
