package com.alarm.application;

import android.animation.ValueAnimator;
import android.app.Dialog;
import android.content.Context;
import android.graphics.Canvas;
import android.graphics.LinearGradient;
import android.graphics.Paint;
import android.graphics.Path;
import android.graphics.RadialGradient;
import android.graphics.RectF;
import android.graphics.Shader;
import android.graphics.Typeface;
import android.graphics.drawable.ColorDrawable;
import android.view.Gravity;
import android.view.View;
import android.view.Window;
import android.view.animation.LinearInterpolator;
import android.view.animation.OvershootInterpolator;
import android.widget.LinearLayout;
import android.widget.TextView;
public final class BadgeView extends View {
    public static final int TIER_BRONZE = 1;
    public static final int TIER_SILVER = 2;
    public static final int TIER_GOLD = 3;

    private final int tier;
    private final int rank;
    private final boolean unlocked;
    private final boolean bigMode;
    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
    private final Path path = new Path();
    private final RectF rect = new RectF();
    private float shimmer = 0f;
    private ValueAnimator anim;

    public BadgeView(Context c, int tier, int rank, boolean unlocked, boolean bigMode) {
        super(c);
        this.tier = tier;
        this.rank = Math.max(1, Math.min(12, rank));
        this.unlocked = unlocked;
        this.bigMode = bigMode;
    }
    private int[] palette() {
        if (!unlocked) {
            return new int[]{0xFFD6D8DC, 0xFF9EA2A8, 0xFF676B72, 0xFF42454C, 0xFF555960};
        }
        int[] gems = {
            0xFF6D3B1A, 0xFF2E5A27, 0xFF8C2D19, 0xFF1F4E78,
            0xFF1B4F72, 0xFF0E6251, 0xFF512E5F, 0xFF154360,
            0xFF922B21, 0xFF78281F, 0xFF1A237E, 0xFF4A148C
        };
        int gem = gems[rank - 1];
        if (tier == TIER_BRONZE) {
            return new int[]{0xFFFFE6D0, 0xFFD98A54, 0xFF9C5221, 0xFF4E2004, gem};
        } else if (tier == TIER_SILVER) {
            return new int[]{0xFFFFFFFF, 0xFFDCE6F2, 0xFF7F92A8, 0xFF3B4959, gem};
        } else {
            return new int[]{0xFFFFFAE0, 0xFFFFD54F, 0xFFD48806, 0xFF6B3800, gem};
        }
    }

    @Override
    protected void onAttachedToWindow() {
        super.onAttachedToWindow();
        if (unlocked && bigMode) {
            anim = ValueAnimator.ofFloat(0f, 1f);
            anim.setDuration(2400);
            anim.setRepeatCount(ValueAnimator.INFINITE);
            anim.setInterpolator(new LinearInterpolator());
            anim.addUpdateListener(new ValueAnimator.AnimatorUpdateListener() {
                @Override
                public void onAnimationUpdate(ValueAnimator a) {
                    shimmer = (Float) a.getAnimatedValue();
                    invalidate();
                }
            });
            anim.start();
        }
    }

    @Override
    protected void onDetachedFromWindow() {
        if (anim != null) anim.cancel();
        super.onDetachedFromWindow();
    }
    @Override
    protected void onDraw(Canvas canvas) {
        super.onDraw(canvas);
        float w = getWidth();
        float h = getHeight();
        if (w <= 0 || h <= 0) return;

        int[] pal = palette();
        float cx = w / 2f;
        float cy = h * 0.50f;
        float R = Math.min(w, h) * 0.34f;

        if (rank == 12) drawHalo(canvas, cx, cy, R * 1.40f, pal);
        if (rank == 5 || rank == 7 || rank >= 9) {
            int wings = (rank == 12) ? 4 : ((rank >= 9) ? 3 : 2);
            drawWings(canvas, cx, cy, R, wings, pal);
        }
        if (rank == 3 || rank == 6 || rank >= 8) {
            drawRibbonTails(canvas, cx, cy, R, pal);
        }
        if (rank == 6 || rank == 8 || rank == 11 || rank == 12) {
            drawLaurel(canvas, cx, cy, R * 1.12f, pal);
        }

        int shieldType = (rank - 1) % 6;
        drawFrame(canvas, cx, cy, R, shieldType, pal);
        drawUniqueEmblem(canvas, cx, cy, R * 0.56f, rank, pal);

        if (rank >= 9) {
            drawTopCrown(canvas, cx, cy - R * 0.88f, R * (rank == 12 ? 0.50f : 0.38f), pal);
            drawBottomBanner(canvas, cx, cy + R * 0.80f, R * 0.92f, pal);
        }

        drawShimmerOverlay(canvas, cx, cy, R * 1.3f);
    }
    private void drawFrame(Canvas c, float cx, float cy, float R, int frameType, int[] pal) {
        buildFramePath(cx, cy + R * 0.06f, R * 1.04f, frameType);
        paint.setShader(null);
        paint.setColor(0x44000000);
        c.drawPath(path, paint);

        buildFramePath(cx, cy, R, frameType);
        paint.setShader(new LinearGradient(cx - R, cy - R, cx + R, cy + R,
                new int[]{pal[0], pal[1], pal[2], pal[3]},
                new float[]{0f, 0.35f, 0.72f, 1f}, Shader.TileMode.CLAMP));
        c.drawPath(path, paint);

        buildFramePath(cx, cy, R * 0.84f, frameType);
        paint.setShader(new LinearGradient(cx + R, cy + R, cx - R, cy - R, pal[0], pal[3], Shader.TileMode.CLAMP));
        c.drawPath(path, paint);

        buildFramePath(cx, cy, R * 0.77f, frameType);
        paint.setShader(new RadialGradient(cx - R * 0.2f, cy - R * 0.2f, R * 0.9f, pal[4], pal[3], Shader.TileMode.CLAMP));
        c.drawPath(path, paint);
    }

    private void buildFramePath(float cx, float cy, float r, int type) {
        path.reset();
        if (type == 0) {
            path.addCircle(cx, cy, r, Path.Direction.CW);
        } else if (type == 1) {
            for (int i = 0; i < 6; i++) {
                double a = Math.toRadians(-90 + i * 60);
                float x = cx + (float) (r * Math.cos(a)), y = cy + (float) (r * Math.sin(a));
                if (i == 0) path.moveTo(x, y); else path.lineTo(x, y);
            }
            path.close();
        } else if (type == 2) {
            path.moveTo(cx - r * 0.84f, cy - r * 0.80f);
            path.quadTo(cx, cy - r * 1.02f, cx + r * 0.84f, cy - r * 0.80f);
            path.quadTo(cx + r * 0.90f, cy + r * 0.35f, cx, cy + r * 1.08f);
            path.quadTo(cx - r * 0.90f, cy + r * 0.35f, cx - r * 0.84f, cy - r * 0.80f);
            path.close();
        } else if (type == 3) {
            for (int i = 0; i < 8; i++) {
                double a = Math.toRadians(-67.5 + i * 45);
                float x = cx + (float) (r * Math.cos(a)), y = cy + (float) (r * Math.sin(a));
                if (i == 0) path.moveTo(x, y); else path.lineTo(x, y);
            }
            path.close();
        } else if (type == 4) {
            for (int i = 0; i < 24; i++) {
                double a = Math.toRadians(-90 + i * 15);
                float rad = (i % 2 == 0) ? r * 1.04f : r * 0.88f;
                float x = cx + (float) (rad * Math.cos(a)), y = cy + (float) (rad * Math.sin(a));
                if (i == 0) path.moveTo(x, y); else path.lineTo(x, y);
            }
            path.close();
        } else {
            path.moveTo(cx, cy - r * 1.06f);
            path.lineTo(cx + r * 0.92f, cy - r * 0.30f);
            path.lineTo(cx + r * 0.66f, cy + r * 0.72f);
            path.lineTo(cx, cy + r * 1.08f);
            path.lineTo(cx - r * 0.66f, cy + r * 0.72f);
            path.lineTo(cx - r * 0.92f, cy - r * 0.30f);
            path.close();
        }
    }
    private void drawWings(Canvas c, float cx, float cy, float R, int layers, int[] pal) {
        for (int s = -1; s <= 1; s += 2) {
            c.save();
            c.translate(cx, cy);
            c.scale(s, 1f);
            for (int i = layers - 1; i >= 0; i--) {
                float reach = R * (1.15f + i * 0.14f);
                float yTop = -R * (0.50f - i * 0.16f);
                float yBot = yTop + R * 0.34f;
                path.reset();
                path.moveTo(R * 0.45f, yTop + R * 0.14f);
                path.quadTo(reach * 0.72f, yTop - R * 0.20f, reach, yTop - R * 0.05f);
                path.quadTo(reach * 0.86f, yBot, R * 0.42f, yBot + R * 0.08f);
                path.close();
                paint.setShader(new LinearGradient(R * 0.4f, yTop, reach, yBot,
                        (i % 2 == 0) ? pal[0] : pal[1], pal[2], Shader.TileMode.CLAMP));
                c.drawPath(path, paint);
            }
            c.restore();
        }
    }

    private void drawLaurel(Canvas c, float cx, float cy, float rad, int[] pal) {
        paint.setShader(null);
        for (int s = -1; s <= 1; s += 2) {
            for (int i = 0; i < 6; i++) {
                double a = Math.toRadians(90 - s * (25 + i * 22));
                c.save();
                c.translate(cx + (float) (rad * Math.cos(a)), cy + (float) (rad * Math.sin(a)));
                c.rotate(s * (35 - i * 18));
                rect.set(-rad * 0.07f, -rad * 0.16f, rad * 0.07f, rad * 0.16f);
                paint.setColor((i % 2 == 0) ? pal[0] : pal[1]);
                c.drawOval(rect, paint);
                c.restore();
            }
        }
    }

    private void drawHalo(Canvas c, float cx, float cy, float rad, int[] pal) {
        for (int i = 0; i < 8; i++) {
            c.save();
            c.translate(cx, cy);
            c.rotate(i * 45f);
            path.reset();
            path.moveTo(0, -rad);
            path.lineTo(rad * 0.13f, -rad * 0.45f);
            path.lineTo(-rad * 0.13f, -rad * 0.45f);
            path.close();
            paint.setShader(new LinearGradient(0, -rad, 0, 0, pal[0], pal[2], Shader.TileMode.CLAMP));
            c.drawPath(path, paint);
            c.restore();
        }
    }

    private void drawRibbonTails(Canvas c, float cx, float cy, float R, int[] pal) {
        float rw = R * 0.50f, top = cy + R * 0.55f, bot = cy + R * 1.24f;
        path.reset();
        path.moveTo(cx - rw, top);
        path.lineTo(cx + rw, top);
        path.lineTo(cx + rw * 1.15f, bot);
        path.lineTo(cx, bot - R * 0.24f);
        path.lineTo(cx - rw * 1.15f, bot);
        path.close();
        paint.setShader(new LinearGradient(cx - rw, top, cx + rw, bot, pal[2], pal[3], Shader.TileMode.CLAMP));
        c.drawPath(path, paint);
    }

    private void drawTopCrown(Canvas c, float cx, float baseY, float cw, int[] pal) {
        float ch = cw * 0.62f;
        path.reset();
        path.moveTo(cx - cw * 0.75f, baseY);
        path.lineTo(cx - cw * 0.90f, baseY - ch * 0.75f);
        path.lineTo(cx - cw * 0.40f, baseY - ch * 0.32f);
        path.lineTo(cx, baseY - ch);
        path.lineTo(cx + cw * 0.40f, baseY - ch * 0.32f);
        path.lineTo(cx + cw * 0.90f, baseY - ch * 0.75f);
        path.lineTo(cx + cw * 0.75f, baseY);
        path.close();
        paint.setShader(new LinearGradient(cx - cw, baseY - ch, cx + cw, baseY, pal[0], pal[2], Shader.TileMode.CLAMP));
        c.drawPath(path, paint);
    }

    private void drawBottomBanner(Canvas c, float cx, float by, float bw, int[] pal) {
        float bh = bw * 0.20f;
        rect.set(cx - bw, by - bh, cx + bw, by + bh);
        paint.setShader(new LinearGradient(cx - bw, by, cx + bw, by,
                new int[]{pal[2], pal[0], pal[1], pal[2]}, new float[]{0f, 0.35f, 0.65f, 1f}, Shader.TileMode.CLAMP));
        c.drawRoundRect(rect, bh * 0.5f, bh * 0.5f, paint);
    }
    private void drawUniqueEmblem(Canvas c, float cx, float cy, float r, int rk, int[] pal) {
        paint.setShader(new LinearGradient(cx - r, cy - r, cx + r, cy + r, pal[0], pal[1], Shader.TileMode.CLAMP));
        if (rk == 1) {
            rect.set(cx - r * 0.68f, cy - r * 0.48f, cx + r * 0.68f, cy + r * 0.88f);
            c.drawArc(rect, 180f, 180f, true, paint);
            paint.setColor(pal[0]);
            paint.setShader(null);
            rect.set(cx - r * 0.85f, cy + r * 0.32f, cx + r * 0.85f, cy + r * 0.50f);
            c.drawRoundRect(rect, r * 0.1f, r * 0.1f, paint);
            rect.set(cx - r * 0.55f, cy + r * 0.62f, cx + r * 0.55f, cy + r * 0.78f);
            c.drawRoundRect(rect, r * 0.1f, r * 0.1f, paint);
        } else if (rk == 2) {
            path.reset();
            path.moveTo(cx, cy + r * 0.85f);
            path.lineTo(cx, cy - r * 0.25f);
            path.moveTo(cx, cy + r * 0.15f);
            path.quadTo(cx - r * 0.88f, cy - r * 0.10f, cx - r * 0.65f, cy - r * 0.75f);
            path.quadTo(cx - r * 0.05f, cy - r * 0.55f, cx, cy + r * 0.15f);
            path.moveTo(cx, cy - r * 0.05f);
            path.quadTo(cx + r * 0.88f, cy - r * 0.30f, cx + r * 0.65f, cy - r * 0.90f);
            path.quadTo(cx + r * 0.05f, cy - r * 0.70f, cx, cy - r * 0.05f);
            c.drawPath(path, paint);
            rect.set(cx - r * 0.10f, cy - r * 0.25f, cx + r * 0.10f, cy + r * 0.85f);
            c.drawRoundRect(rect, r * 0.05f, r * 0.05f, paint);
        } else if (rk == 3) {
            path.reset();
            path.moveTo(cx, cy - r * 0.98f);
            path.cubicTo(cx + r * 0.65f, cy - r * 0.35f, cx + r * 0.95f, cy + r * 0.35f, cx, cy + r * 0.92f);
            path.cubicTo(cx - r * 0.95f, cy + r * 0.35f, cx - r * 0.65f, cy - r * 0.35f, cx, cy - r * 0.98f);
            c.drawPath(path, paint);
        } else if (rk == 4) {
            path.reset();
            path.moveTo(cx + r * 0.22f, cy - r * 0.98f);
            path.lineTo(cx - r * 0.68f, cy + r * 0.08f);
            path.lineTo(cx - r * 0.05f, cy + r * 0.08f);
            path.lineTo(cx - r * 0.28f, cy + r * 0.98f);
            path.lineTo(cx + r * 0.68f, cy - r * 0.12f);
            path.lineTo(cx + r * 0.05f, cy - r * 0.12f);
            path.close();
            c.drawPath(path, paint);
        } else if (rk == 5) {
            path.reset();
            path.moveTo(cx, cy - r * 0.65f);
            path.lineTo(cx + r * 0.22f, cy - r * 0.30f);
            path.quadTo(cx + r * 0.98f, cy - r * 0.75f, cx + r * 0.95f, cy - r * 0.05f);
            path.quadTo(cx + r * 0.45f, cy + r * 0.25f, cx + r * 0.28f, cy + r * 0.85f);
            path.lineTo(cx, cy + r * 0.62f);
            path.lineTo(cx - r * 0.28f, cy + r * 0.85f);
            path.quadTo(cx - r * 0.45f, cy + r * 0.25f, cx - r * 0.95f, cy - r * 0.05f);
            path.quadTo(cx - r * 0.98f, cy - r * 0.75f, cx - r * 0.22f, cy - r * 0.30f);
            path.close();
            c.drawPath(path, paint);
        } else if (rk == 6) {
            path.reset();
            path.moveTo(cx - r * 0.68f, cy - r * 0.82f);
            path.lineTo(cx + r * 0.68f, cy - r * 0.82f);
            path.lineTo(cx + r * 0.12f, cy);
            path.lineTo(cx + r * 0.68f, cy + r * 0.82f);
            path.lineTo(cx - r * 0.68f, cy + r * 0.82f);
            path.lineTo(cx - r * 0.12f, cy);
            path.close();
            c.drawPath(path, paint);
        } else {
            drawUniqueEmblemHigh(c, cx, cy, r, rk, pal);
        }
    }
    private void drawUniqueEmblemHigh(Canvas c, float cx, float cy, float r, int rk, int[] pal) {
        if (rk == 7) {
            path.reset();
            path.moveTo(cx, cy - r * 1.02f);
            path.lineTo(cx + r * 0.18f, cy - r * 0.65f);
            path.lineTo(cx + r * 0.14f, cy + r * 0.32f);
            path.lineTo(cx - r * 0.14f, cy + r * 0.32f);
            path.lineTo(cx - r * 0.18f, cy - r * 0.65f);
            path.close();
            c.drawPath(path, paint);
            rect.set(cx - r * 0.62f, cy + r * 0.28f, cx + r * 0.62f, cy + r * 0.46f);
            c.drawRoundRect(rect, r * 0.08f, r * 0.08f, paint);
        } else if (rk == 8) {
            path.reset();
            path.moveTo(cx - r * 0.52f, cy - r * 0.72f);
            path.lineTo(cx + r * 0.52f, cy - r * 0.72f);
            path.lineTo(cx + r * 0.92f, cy - r * 0.22f);
            path.lineTo(cx, cy + r * 0.95f);
            path.lineTo(cx - r * 0.92f, cy - r * 0.22f);
            path.close();
            c.drawPath(path, paint);
        } else if (rk == 9) {
            path.reset();
            path.moveTo(cx - r * 0.68f, cy - r * 0.78f);
            path.lineTo(cx + r * 0.68f, cy - r * 0.78f);
            path.quadTo(cx + r * 0.58f, cy + r * 0.22f, cx, cy + r * 0.28f);
            path.quadTo(cx - r * 0.58f, cy + r * 0.22f, cx - r * 0.68f, cy - r * 0.78f);
            path.close();
            c.drawPath(path, paint);
        } else if (rk == 10) {
            drawTopCrown(c, cx, cy + r * 0.52f, r * 0.95f, pal);
        } else if (rk == 11) {
            for (int i = 0; i < 4; i++) {
                c.save();
                c.translate(cx, cy);
                c.rotate(i * 45f);
                float len = (i % 2 == 0) ? r * 1.02f : r * 0.72f;
                float wid = r * 0.18f;
                path.reset();
                path.moveTo(0, -len);
                path.lineTo(wid, 0);
                path.lineTo(0, len);
                path.lineTo(-wid, 0);
                path.close();
                paint.setShader(null);
                paint.setColor((i % 2 == 0) ? pal[0] : pal[1]);
                c.drawPath(path, paint);
                c.restore();
            }
        } else {
            for (int s = -1; s <= 1; s += 2) {
                c.save();
                c.translate(cx, cy);
                c.rotate(s * 36f);
                rect.set(-r * 0.09f, -r * 0.95f, r * 0.09f, r * 0.95f);
                paint.setShader(null);
                paint.setColor(pal[1]);
                c.drawRoundRect(rect, r * 0.05f, r * 0.05f, paint);
                c.restore();
            }
            drawTopCrown(c, cx, cy + r * 0.42f, r * 0.85f, pal);
        }
    }
    private void drawShimmerOverlay(Canvas c, float cx, float cy, float R) {
        if (!unlocked || !bigMode) return;
        float pos = -1.2f + 2.4f * shimmer;
        float sx = cx + pos * R;
        float sy = cy + pos * R;
        paint.setShader(new LinearGradient(sx - R * 0.35f, sy - R * 0.35f,
                sx + R * 0.35f, sy + R * 0.35f,
                new int[]{0x00FFFFFF, 0x77FFFFFF, 0x00FFFFFF},
                new float[]{0f, 0.5f, 1f}, Shader.TileMode.CLAMP));
        c.drawCircle(cx, cy, R, paint);
    }

    public static void showCelebration(final Context c, final Stats.Badge b, final Runnable onDismiss) {
        final Dialog dlg = new Dialog(c);
        dlg.requestWindowFeature(Window.FEATURE_NO_TITLE);

        LinearLayout root = new LinearLayout(c);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setGravity(Gravity.CENTER_HORIZONTAL);
        root.setPadding(Ui.dp(c, 24), Ui.dp(c, 28), Ui.dp(c, 24), Ui.dp(c, 24));
        root.setBackground(Ui.shape(c, Ui.surface, 36));

        String tierTag = b.tier == TIER_GOLD ? "荣耀黄金阶" : (b.tier == TIER_SILVER ? "璀璨白银阶" : "坚韧青铜阶");
        TextView head = Ui.tv(c, b.got ? "🎉 成就已解锁 · " + tierTag : "尚未解锁 · " + tierTag,
                14, b.got ? Ui.primary : Ui.textVar, "sans-serif-medium");
        root.addView(head);

        int screenH = c.getResources().getDisplayMetrics().heightPixels;
        int medalSize = (int) (screenH * 0.38f);
        final BadgeView bv = new BadgeView(c, b.tier, b.style, b.got, true);
        LinearLayout.LayoutParams mp = new LinearLayout.LayoutParams(medalSize, medalSize);
        mp.topMargin = Ui.dp(c, 8);
        mp.bottomMargin = Ui.dp(c, 8);
        root.addView(bv, mp);

        bv.setScaleX(0.25f);
        bv.setScaleY(0.25f);
        bv.setRotation(-15f);
        bv.animate().scaleX(1f).scaleY(1f).rotation(0f)
                .setDuration(680)
                .setInterpolator(new OvershootInterpolator(1.35f))
                .start();

        TextView title = Ui.tv(c, b.name, 26, Ui.text, "sans-serif-medium");
        title.setTypeface(Typeface.create("sans-serif-medium", Typeface.BOLD));
        title.setGravity(Gravity.CENTER);
        root.addView(title);

        TextView desc = Ui.tv(c, b.desc, 15, Ui.textVar, "sans-serif");
        desc.setGravity(Gravity.CENTER);
        desc.setPadding(0, Ui.dp(c, 6), 0, Ui.dp(c, 12));
        root.addView(desc);

        String dateLine = b.got
                ? ("你已于 " + b.dateText + " 达成此项成就")
                : "继续坚持早起与答题，即可点亮此枚段位勋章";
