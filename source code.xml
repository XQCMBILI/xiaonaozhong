package com.alarm.application;

import android.animation.ValueAnimator;
import android.content.Context;
import android.graphics.Canvas;
import android.graphics.Paint;
import android.graphics.Typeface;
import android.media.AudioAttributes;
import android.media.AudioFormat;
import android.media.AudioManager;
import android.media.AudioTrack;
import android.os.Build;
import android.os.Handler;
import android.os.HandlerThread;
import android.os.Process;
import android.view.HapticFeedbackConstants;
import android.view.MotionEvent;
import android.view.VelocityTracker;
import android.view.View;
import android.view.ViewConfiguration;
import android.view.ViewGroup;
import android.view.animation.DecelerateInterpolator;
import android.view.animation.OvershootInterpolator;
import android.widget.NumberPicker;
import android.widget.OverScroller;

import java.util.ArrayList;
import java.util.List;
import java.util.Locale;

final class PickerStyle {
    private static final int POOL_SIZE = 4;
    private static final AudioTrack[] tracks = new AudioTrack[POOL_SIZE];
    private static int poolIdx = 0;
    private static Handler audioHandler;
    private static long lastTickMs;

    private static void initFastAudio() {
        if (audioHandler != null) return;
        HandlerThread ht = new HandlerThread("FastWheelAudio", Process.THREAD_PRIORITY_URGENT_AUDIO);
        ht.start();
        audioHandler = new Handler(ht.getLooper());
        audioHandler.post(new Runnable() {
            @Override
            public void run() {
                buildStaticTracks();
            }
        });
    }

    /** 1:1 模拟 iPhone 机械滚轮波形：3500Hz 极高频金属瞬态碰撞 + 800Hz 腔体清脆共鸣 */
    private static void buildStaticTracks() {
        try {
            int sr = 44100;
            int samples = sr * 4 / 1000; // 4毫秒极短促、极清脆的机械棘轮声
            short[] pcm = new short[samples];
            for (int i = 0; i < samples; i++) {
                double t = (double) i / sr;
                // 极速指数衰减，模拟真实金属齿轮碰撞的干脆利落
                double env = Math.exp(-i / (samples * 0.08));
                double wave = 0.55 * Math.sin(2.0 * Math.PI * 3500.0 * t) * Math.exp(-i / (samples * 0.04))
                            + 0.45 * Math.sin(2.0 * Math.PI * 820.0 * t) * env;
                pcm[i] = (short) Math.max(-32767, Math.min(32767, wave * 31000));
            }
            int byteSize = samples * 2;
            for (int i = 0; i < POOL_SIZE; i++) {
                AudioTrack at;
                if (Build.VERSION.SDK_INT >= 21) {
                    AudioAttributes attrs = new AudioAttributes.Builder()
                            .setUsage(AudioAttributes.USAGE_GAME)
                            .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)
                            .setFlags(AudioAttributes.FLAG_LOW_LATENCY)
                            .build();
                    AudioFormat fmt = new AudioFormat.Builder()
                            .setSampleRate(sr)
                            .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
                            .setChannelMask(AudioFormat.CHANNEL_OUT_MONO)
                            .build();
                    at = new AudioTrack(attrs, fmt, byteSize,
                            AudioTrack.MODE_STATIC, AudioManager.AUDIO_SESSION_ID_GENERATE);
                } else {
                    at = new AudioTrack(AudioManager.STREAM_MUSIC, sr,
                            AudioFormat.CHANNEL_OUT_MONO, AudioFormat.ENCODING_PCM_16BIT,
                            byteSize, AudioTrack.MODE_STATIC);
                }
                at.write(pcm, 0, pcm.length);
                tracks[i] = at;
            }
        } catch (Throwable ignored) {}
    }
    /** 提前预热唤醒音频硬件，彻底根治“第一下声音小/有延迟”的毛病 */
    private static void warmUpHardware() {
        initFastAudio();
        if (audioHandler == null) return;
        audioHandler.post(new Runnable() {
            @Override
            public void run() {
                try {
                    AudioTrack at = tracks[0];
                    if (at != null && at.getPlayState() != AudioTrack.PLAYSTATE_PLAYING) {
                        if (Build.VERSION.SDK_INT >= 21) at.setVolume(0.001f);
                        at.stop();
                        at.setPlaybackHeadPosition(0);
                        at.play();
                    }
                } catch (Throwable ignored) {}
            }
        });
    }

    static void playMechanicalTick() {
        long now = android.os.SystemClock.uptimeMillis();
        if (now - lastTickMs < 12) return;
        lastTickMs = now;
        initFastAudio();
        if (audioHandler == null) return;
        audioHandler.post(new Runnable() {
            @Override
            public void run() {
                try {
                    AudioTrack at = tracks[poolIdx];
                    poolIdx = (poolIdx + 1) % POOL_SIZE;
                    if (at != null) {
                        if (at.getPlayState() == AudioTrack.PLAYSTATE_PLAYING) {
                            at.stop();
                        }
                        if (Build.VERSION.SDK_INT >= 21) at.setVolume(1.0f);
                        at.setPlaybackHeadPosition(0);
                        at.play();
                    }
                } catch (Throwable ignored) {}
            }
        });
    }

    static WheelPicker create(Context c, int min, int max, int val, Widgets.IntCb cb) {
        initFastAudio();
        warmUpHardware(); // 控件创建即刻预热
        return new WheelPicker(c, min, max, val, cb);
    }

    static final class WheelPicker extends View {
        private final int min;
        private final int max;
        private final int count;
        private final Widgets.IntCb cb;
        private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
        private final OverScroller scroller;
        private VelocityTracker vt;
        private final int minFling;
        private final int maxFling;

        private float itemH;
        private float scrollPx;
        private float lastY;
        private boolean dragging;
        private int currentVal;
        private int lastTickIndex;

        private float activeBoost = 0f;
        private float tickPulse = 0f;
        private ValueAnimator boostAnim;
        private ValueAnimator pulseAnim;

        WheelPicker(Context c, int minVal, int maxVal, int initVal, Widgets.IntCb callback) {
            super(c);
            this.min = minVal;
            this.max = maxVal;
            this.count = maxVal - minVal + 1;
            this.cb = callback;
            this.currentVal = Math.max(minVal, Math.min(maxVal, initVal));
            this.scroller = new OverScroller(c, new DecelerateInterpolator(1.8f));
            ViewConfiguration vc = ViewConfiguration.get(c);
            this.minFling = vc.getScaledMinimumFlingVelocity();
            this.maxFling = vc.getScaledMaximumFlingVelocity();
            this.paint.setTextAlign(Paint.Align.CENTER);
        }

        int getValue() {
            return currentVal;
        }

        private void animateBoost(float to) {
            if (boostAnim != null) boostAnim.cancel();
            boostAnim = ValueAnimator.ofFloat(activeBoost, to);
            boostAnim.setDuration(to > activeBoost ? 140 : 280);
            boostAnim.setInterpolator(to > activeBoost
                    ? new DecelerateInterpolator()
                    : new OvershootInterpolator(1.5f));
            boostAnim.addUpdateListener(new ValueAnimator.AnimatorUpdateListener() {
                @Override
                public void onAnimationUpdate(ValueAnimator a) {
                    activeBoost = (Float) a.getAnimatedValue();
                    invalidate();
                }
            });
            boostAnim.start();
        }

        private void triggerPulse() {
            if (pulseAnim != null) pulseAnim.cancel();
            pulseAnim = ValueAnimator.ofFloat(1f, 0f);
            pulseAnim.setDuration(120);
            pulseAnim.addUpdateListener(new ValueAnimator.AnimatorUpdateListener() {
                @Override
                public void onAnimationUpdate(ValueAnimator a) {
                    tickPulse = (Float) a.getAnimatedValue();
                    invalidate();
                }
            });
            pulseAnim.start();
        }
        @Override
        protected void onSizeChanged(int w, int h, int oldw, int oldh) {
            super.onSizeChanged(w, h, oldw, oldh);
            itemH = h / 3.5f;
            scrollPx = (currentVal - min) * itemH;
            lastTickIndex = Math.round(scrollPx / itemH);
        }

        @Override
        public boolean onTouchEvent(MotionEvent ev) {
            if (itemH <= 0) return false;
            if (vt == null) vt = VelocityTracker.obtain();
            vt.addMovement(ev);

            int act = ev.getActionMasked();
            float y = ev.getY();
            if (act == MotionEvent.ACTION_DOWN) {
                warmUpHardware();
                if (!scroller.isFinished()) scroller.abortAnimation();
                dragging = true;
                lastY = y;
                if (getParent() != null) getParent().requestDisallowInterceptTouchEvent(true);
                animateBoost(1f);
                return true;
            } else if (act == MotionEvent.ACTION_MOVE) {
                if (getParent() != null) getParent().requestDisallowInterceptTouchEvent(true);
                float dy = lastY - y;
                scrollPx += dy;
                lastY = y;
                checkTick();
                invalidate();
                return true;
            } else if (act == MotionEvent.ACTION_UP || act == MotionEvent.ACTION_CANCEL) {
                vt.computeCurrentVelocity(1000, maxFling);
                int vy = (int) vt.getYVelocity();
                vt.recycle();
                vt = null;

                if (Math.abs(vy) > minFling) {
                    scroller.fling(0, Math.round(scrollPx), 0, -vy,
                            0, 0, Integer.MIN_VALUE / 2, Integer.MAX_VALUE / 2);
                    postInvalidateOnAnimation();
                } else {
                    snapToNearest();
                }
                dragging = false;
                return true;
            }
            return true;
        }

        private void snapToNearest() {
            int targetIdx = Math.round(scrollPx / itemH);
            int targetPx = Math.round(targetIdx * itemH);
            int delta = targetPx - Math.round(scrollPx);
            if (Math.abs(delta) > 1) {
                scroller.startScroll(0, Math.round(scrollPx), 0, delta, 200);
                postInvalidateOnAnimation();
            } else {
                scrollPx = targetPx;
                checkTick();
                animateBoost(0f);
                invalidate();
            }
        }

        @Override
        public void computeScroll() {
            if (scroller.computeScrollOffset()) {
                scrollPx = scroller.getCurrY();
                checkTick();
                postInvalidateOnAnimation();
            } else if (!dragging && itemH > 0) {
                int targetPx = Math.round(Math.round(scrollPx / itemH) * itemH);
                if (Math.abs(targetPx - scrollPx) > 1f) {
                    snapToNearest();
                } else if (activeBoost > 0.01f && (boostAnim == null || !boostAnim.isRunning())) {
                    scrollPx = targetPx;
                    animateBoost(0f);
                }
            }
        }

        private void checkTick() {
            if (itemH <= 0) return;
            int idx = Math.round(scrollPx / itemH);
            if (idx != lastTickIndex) {
                lastTickIndex = idx;
                int wrapped = ((idx % count) + count) % count;
                currentVal = min + wrapped;
                playMechanicalTick();
                int tick = Build.VERSION.SDK_INT >= 21
                        ? HapticFeedbackConstants.CLOCK_TICK
                        : HapticFeedbackConstants.KEYBOARD_TAP;
                performHapticFeedback(tick, HapticFeedbackConstants.FLAG_IGNORE_GLOBAL_SETTING);
                triggerPulse();
                if (cb != null) cb.on(currentVal);
            }
        }
        @Override
        protected void onDraw(Canvas canvas) {
            super.onDraw(canvas);
            if (itemH <= 0) return;
            float w = getWidth();
            float h = getHeight();
            float cy = h / 2f;

            int centerIdx = (int) Math.floor(scrollPx / itemH);
            for (int offset = -2; offset <= 2; offset++) {
                int idx = centerIdx + offset;
                float itemCenterY = cy + (idx * itemH - scrollPx);
                float dist = Math.abs(itemCenterY - cy);
                if (dist > itemH * 1.75f) continue;

                float norm = Math.min(1f, dist / itemH);
                float focus = 1f - norm;
                focus = focus * focus * (3f - 2f * focus);

                float minSp = 15f - 3f * activeBoost;
                float maxSp = 52f + 16f * activeBoost + 5f * tickPulse;
                float curSp = minSp + (maxSp - minSp) * focus;
                paint.setTextSize(Ui.dp(getContext(), curSp));

                paint.setTypeface(Typeface.create(
                        focus > 0.45f ? "sans-serif-medium" : "sans-serif",
                        focus > 0.45f ? Typeface.BOLD : Typeface.NORMAL));

                int minAlpha = Math.round(105 - 45 * activeBoost);
                int alpha = Math.round(minAlpha + (255 - minAlpha) * focus);
                int baseColor = focus > 0.55f ? (activeBoost > 0.15f ? Ui.primary : Ui.text) : Ui.textVar;
                paint.setColor(Tones.alpha(baseColor, Math.max(0, Math.min(255, alpha))));

                int wrapped = ((idx % count) + count) % count;
                String text = String.format(Locale.US, "%02d", min + wrapped);

                float scaleX = 0.90f + (0.10f + 0.12f * activeBoost) * focus;
                float scaleY = 0.75f + (0.25f + 0.12f * activeBoost) * focus;
                canvas.save();
                canvas.translate(w / 2f, itemCenterY);
                canvas.scale(scaleX, scaleY);
                float baseline = -(paint.ascent() + paint.descent()) / 2f;
                canvas.drawText(text, 0f, baseline, paint);
                canvas.restore();
            }
        }
    }

    static void hideDivider(NumberPicker p) {}
    static void style(NumberPicker p) {}
    static List<NumberPicker> collect(ViewGroup root) { return new ArrayList<NumberPicker>(); }
}
