package com.alarm.application;

import android.content.Context;
import android.view.Gravity;
import android.view.View;
import android.widget.LinearLayout;
import android.widget.TextView;

final class RepeatRow {
    private static final int[] ORDER = {1, 2, 3, 4, 5, 6, 0};
    private static final String[] NAMES = {"一", "二", "三", "四", "五", "六", "日"};

    static LinearLayout build(final Context c, final Alarm d) {
        LinearLayout box = new LinearLayout(c);
        box.setOrientation(LinearLayout.VERTICAL);
        final TextView[] dc = new TextView[7];
        final TextView rep = Ui.tv(c, d.repeatText(), 13, Ui.textVar, "sans-serif");
        rep.setPadding(Ui.dp(c, 4), Ui.dp(c, 8), 0, 0);
        LinearLayout row = new LinearLayout(c);
        for (int i = 0; i < 7; i++) {
            final int idx = i;
            TextView t = Ui.tv(c, NAMES[i], 15, Ui.text, "sans-serif-medium");
            t.setGravity(Gravity.CENTER);
            dc[i] = t;
            t.setOnClickListener(new View.OnClickListener() {
                @Override
                public void onClick(View v) {
                    d.days ^= (1 << ORDER[idx]);
                    restyle(c, d, dc);
                    rep.setText(d.repeatText());
                }
            });
            LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(0, Ui.dp(c, 44), 1f);
            if (i < 6) p.rightMargin = Ui.dp(c, 5);
            row.addView(t, p);
        }
        restyle(c, d, dc);
        box.addView(row);
        box.addView(rep);
        return box;
    }
    private static void restyle(Context c, Alarm d, TextView[] dc) {
        for (int i = 0; i < dc.length; i++) {
            boolean on = (d.days & (1 << ORDER[i])) != 0;
            dc[i].setBackground(Ui.shape(c, on ? Ui.primary : Ui.surface, 22));
            dc[i].setTextColor(on ? Ui.onPrimary : Ui.text);
        }
    }
}
