package com.alarm.application;

import org.json.JSONObject;
import java.util.Calendar;

final class Alarm {
    int id;
    int hour = 7;
    int minute = 0;
    int second = 0;
    int days = 0;
    boolean enabled = true;
    String label = "";
    String ringtone = "";
    boolean gradual = true;
    int rampSec = 30;
    boolean vibrate = true;
    int snoozeMin = 5;
    boolean dawn = false;
    
    // 核心修改：0=关闭答题，1=简单(A)，2=中等(B)，3=困难(C)
    int forceLevel = 0;

    static final String[] DN = {"周日", "周一", "周二", "周三", "周四", "周五", "周六"};

    JSONObject toJson() {
        JSONObject o = new JSONObject();
        try {
            o.put("id", id);
            o.put("hour", hour);
            o.put("minute", minute);
            o.put("second", second);
            o.put("days", days);
            o.put("enabled", enabled);
            o.put("label", label);
            o.put("ringtone", ringtone);
            o.put("gradual", gradual);
            o.put("rampSec", rampSec);
            o.put("vibrate", vibrate);
            o.put("snoozeMin", snoozeMin);
            o.put("dawn", dawn);
            o.put("forceLevel", forceLevel);
        } catch (Exception ignored) {}
        return o;
    }

    static Alarm fromJson(JSONObject o) {
        Alarm a = new Alarm();
        a.id = o.optInt("id");
        a.hour = o.optInt("hour", 7);
        a.minute = o.optInt("minute", 0);
        a.second = o.optInt("second", 0);
        a.days = o.optInt("days", 0);
        a.enabled = o.optBoolean("enabled", true);
        a.label = o.optString("label", "");
        a.ringtone = o.optString("ringtone", "");
        a.gradual = o.optBoolean("gradual", true);
        a.rampSec = o.optInt("rampSec", 30);
        a.vibrate = o.optBoolean("vibrate", true);
        a.snoozeMin = o.optInt("snoozeMin", 5);
        a.dawn = o.optBoolean("dawn", false);
        // 读取保存的难度，没设置过则默认为 0
        a.forceLevel = o.optInt("forceLevel", 0); 
        return a;
    }

    Alarm copy() { return fromJson(toJson()); }

    long nextTrigger() {
        Calendar now = Calendar.getInstance();
        for (int i = 0; i < 8; i++) {
            Calendar c = (Calendar) now.clone();
            c.add(Calendar.DAY_OF_YEAR, i);
            c.set(Calendar.HOUR_OF_DAY, hour);
            c.set(Calendar.MINUTE, minute);
            c.set(Calendar.SECOND, second);
            c.set(Calendar.MILLISECOND, 0);
            if (c.getTimeInMillis() <= now.getTimeInMillis()) continue;
            if (days == 0 || (days & (1 << (c.get(Calendar.DAY_OF_WEEK) - 1))) != 0) {
                return c.getTimeInMillis();
            }
        }
        return -1;
    }

    String repeatText() {
        if (days == 0) return "仅一次";
        if (days == 127) return "每天";
        if (days == 62) return "工作日";
        if (days == 65) return "周末";
        int[] order = {1, 2, 3, 4, 5, 6, 0};
        StringBuilder sb = new StringBuilder();
        for (int d : order) {
            if ((days & (1 << d)) != 0) {
                if (sb.length() > 0) sb.append(" ");
                sb.append(DN[d]);
            }
        }
        return sb.toString();
    }
}
