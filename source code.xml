package com.alarm.application;

import android.app.Dialog;
import android.content.Context;
import android.graphics.drawable.ColorDrawable;
import android.view.Gravity;
import android.view.View;
import android.view.ViewGroup;
import android.view.Window;
import android.widget.FrameLayout;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;

import java.util.List;

final class Home {
    private final MainActivity act;
    private final HeroCard hero = new HeroCard();
    private final BedtimeCard bed;
    private LinearLayout list;
    private FrameLayout permContainer;
    private TextView perm;

    Home(MainActivity a) {
        act = a;
        bed = new BedtimeCard(a);
    }

    private int dp(float v) {
        return Ui.dp(act, v);
    }

    private LinearLayout.LayoutParams gap(int top) {
        LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(Widgets.MATCH, Widgets.WRAP);
        p.topMargin = dp(top);
        return p;
    }
    FrameLayout build() {
        FrameLayout content = new FrameLayout(act);
        if (Theme.gradient) {
            content.addView(new FluidView(act), new FrameLayout.LayoutParams(Widgets.MATCH, Widgets.MATCH));
        }
        ScrollView sv = new ScrollView(act);
        sv.setFillViewport(true);
        sv.setOverScrollMode(View.OVER_SCROLL_NEVER);
        LinearLayout col = new LinearLayout(act);
        col.setOrientation(LinearLayout.VERTICAL);
        col.setPadding(dp(20), dp(56), dp(20), dp(250));
        col.addView(HomeHeader.build(act));
        col.addView(hero.build(act));
        col.addView(bed.build(), gap(14));

        final android.content.SharedPreferences sp = act.getSharedPreferences("alarm_prefs", Context.MODE_PRIVATE);
        permContainer = new FrameLayout(act);
        perm = Ui.tv(act, "", 14, Ui.onTertiaryC, "sans-serif-medium");
        perm.setGravity(Gravity.CENTER);
        perm.setPadding(dp(20), dp(16), dp(48), dp(16));
        perm.setBackground(Ui.ripple(Ui.shape(act, Ui.tertiaryC, 24)));
        perm.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) { PermissionGuide.show(act); }
        });
        permContainer.addView(perm, new FrameLayout.LayoutParams(Widgets.MATCH, Widgets.WRAP));

        TextView closeBtn = Ui.tv(act, "✕", 18, Ui.onTertiaryC, "sans-serif");
        closeBtn.setGravity(Gravity.CENTER);
        FrameLayout.LayoutParams cp = new FrameLayout.LayoutParams(dp(48), dp(48), Gravity.CENTER_VERTICAL | Gravity.END);
        permContainer.addView(closeBtn, cp);
        closeBtn.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) { showHidePermDialog(sp); }
        });

        col.addView(permContainer, gap(14));
        list = new LinearLayout(act);
        list.setOrientation(LinearLayout.VERTICAL);
        col.addView(list, gap(20));
        sv.addView(col, new ViewGroup.LayoutParams(Widgets.MATCH, Widgets.WRAP));
        content.addView(sv, new FrameLayout.LayoutParams(Widgets.MATCH, Widgets.MATCH));
        content.addView(futureBtn(), futureParams());
        content.addView(profileBtn(), profileParams());
        content.addView(fab(), fabParams());
        return content;
    }

    /** 彻底替换丑陋的系统白框，改用纯正 Pixel Material 3 大圆角弹窗 */
    private void showHidePermDialog(final android.content.SharedPreferences sp) {
        final Dialog dlg = new Dialog(act);
        dlg.requestWindowFeature(Window.FEATURE_NO_TITLE);
        LinearLayout box = new LinearLayout(act);
        box.setOrientation(LinearLayout.VERTICAL);
        box.setPadding(dp(24), dp(24), dp(24), dp(20));
        box.setBackground(Ui.shape(act, Ui.bg, 28));

        box.addView(Ui.tv(act, "隐藏权限引导？", 20, Ui.text, "sans-serif-medium"));
        TextView msg = Ui.tv(act, "请确认是否已开启锁屏显示与后台弹出权限。\n若未开启，闹钟在锁屏状态下可能无法正常弹出。",
                14.5f, Ui.textVar, "sans-serif");
        msg.setLineSpacing(dp(3), 1.15f);
        msg.setPadding(0, dp(12), 0, dp(22));
        box.addView(msg);

        LinearLayout bar = new LinearLayout(act);
        bar.setGravity(Gravity.END | Gravity.CENTER_VERTICAL);
        TextView cancel = Ui.tv(act, "取消", 14, Ui.primary, "sans-serif-medium");
        cancel.setPadding(dp(18), dp(11), dp(18), dp(11));
        cancel.setBackground(Ui.ripple(Ui.shape(act, 0, 20)));
        cancel.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) { dlg.dismiss(); }
        });

        TextView ok = Ui.tv(act, "已开启，永久隐藏", 14, Ui.onPrimary, "sans-serif-medium");
        ok.setPadding(dp(20), dp(11), dp(20), dp(11));
        ok.setBackground(Ui.ripple(Ui.shape(act, Ui.primary, 20)));
        LinearLayout.LayoutParams op = new LinearLayout.LayoutParams(Widgets.WRAP, Widgets.WRAP);
        op.leftMargin = dp(8);
        ok.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                sp.edit().putBoolean("hide_perm", true).apply();
                dlg.dismiss();
                refresh();
            }
        });
        bar.addView(cancel);
        bar.addView(ok, op);
        box.addView(bar);

        dlg.setContentView(box);
        Window w = dlg.getWindow();
        if (w != null) {
            w.setBackgroundDrawable(new ColorDrawable(0));
            w.setLayout((int) (act.getResources().getDisplayMetrics().widthPixels * 0.88f), Widgets.WRAP);
            w.setDimAmount(0.45f);
        }
        dlg.show();
    }
    private View futureBtn() {
        TextView b = Ui.tv(act, "📅  未来清单", 14, Ui.onPrimaryC, "sans-serif-medium");
        b.setGravity(Gravity.CENTER);
        b.setPadding(dp(20), dp(12), dp(22), dp(12));
        b.setBackground(Ui.ripple(Ui.shape(act, Ui.secondaryC, 20)));
        b.setElevation(dp(4));
        b.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                act.startActivity(new android.content.Intent(act, FutureActivity.class));
            }
        });
        return b;
    }

    private FrameLayout.LayoutParams futureParams() {
        FrameLayout.LayoutParams fp = new FrameLayout.LayoutParams(
                Widgets.WRAP, Widgets.WRAP, Gravity.BOTTOM | Gravity.END);
        fp.setMargins(0, 0, dp(20), dp(192));
        return fp;
    }

    private View profileBtn() {
        TextView b = Ui.tv(act, "🏆  我的", 16, Ui.onPrimaryC, "sans-serif-medium");
        b.setGravity(Gravity.CENTER);
        b.setPadding(dp(26), dp(16), dp(28), dp(16));
        b.setBackground(Ui.ripple(Ui.shape(act, Ui.primaryC, 22)));
        b.setElevation(dp(4));
        b.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                act.startActivity(new android.content.Intent(act, ProfileActivity.class));
            }
        });
        return b;
    }

    private FrameLayout.LayoutParams profileParams() {
        FrameLayout.LayoutParams fp = new FrameLayout.LayoutParams(
                Widgets.WRAP, Widgets.WRAP, Gravity.BOTTOM | Gravity.END);
        fp.setMargins(0, 0, dp(20), dp(124));
        return fp;
    }

    private View fab() {
        TextView fab = Ui.tv(act, "＋  添加闹钟", 16, Ui.onTertiaryC, "sans-serif-medium");
        fab.setGravity(Gravity.CENTER);
        fab.setPadding(dp(26), dp(20), dp(28), dp(20));
        fab.setBackground(Ui.ripple(Ui.shape(act, Ui.tertiaryC, 22)));
        fab.setElevation(dp(6));
        fab.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) { act.edit(null); }
        });
        return fab;
    }

    private FrameLayout.LayoutParams fabParams() {
        FrameLayout.LayoutParams fp = new FrameLayout.LayoutParams(
                Widgets.WRAP, Widgets.WRAP, Gravity.BOTTOM | Gravity.END);
        fp.setMargins(0, 0, dp(20), dp(48));
        return fp;
    }

    void refresh() {
        List<Alarm> alarms = AlarmStore.all(act);
        list.removeAllViews();
        if (alarms.isEmpty()) {
            showEmpty();
        } else {
            for (Alarm a : alarms) list.addView(AlarmCard.build(act, a), gap(12));
        }
        hero.update(alarms);
        bed.update();
        Bedtime.schedule(act);
        FutureStore.rescheduleAll(act);
        
        final android.content.SharedPreferences sp = act.getSharedPreferences("alarm_prefs", Context.MODE_PRIVATE);
        if (sp.getBoolean("hide_perm", false)) {
            permContainer.setVisibility(View.GONE);
        } else {
            permContainer.setVisibility(View.VISIBLE);
            if (PermissionGuide.allOk(act)) {
                perm.setText("锁屏弹出设置（点这里检查）");
            } else {
                perm.setText("⚠ 锁屏时可能不弹出，点此开启");
            }
        }
    }

    void tick() {
        hero.update(AlarmStore.all(act));
    }

    private void showEmpty() {
        LinearLayout e = new LinearLayout(act);
        e.setOrientation(LinearLayout.VERTICAL);
        e.setGravity(Gravity.CENTER_HORIZONTAL);
        e.setPadding(0, dp(40), 0, dp(24));
        e.addView(Ui.tv(act, "⏰", 56, Ui.text, "sans-serif"));
        TextView t1 = Ui.tv(act, "还没有闹钟", 20, Ui.text, "sans-serif-medium");
        t1.setPadding(0, dp(16), 0, dp(4));
        e.addView(t1);
        e.addView(Ui.tv(act, "点右下角，添加一个叫你起床的闹钟", 14, Ui.textVar, "sans-serif"));
        list.addView(e);
    }
}
