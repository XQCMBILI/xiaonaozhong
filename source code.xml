package com.alarm.application;

import android.app.AlarmManager;
import android.app.PendingIntent;
import android.content.Context;
import android.content.Intent;
import android.content.SharedPreferences;
import android.os.Build;

import org.json.JSONArray;
import org.json.JSONObject;

import java.util.ArrayList;
import java.util.Calendar;
import java.util.Collections;
import java.util.Comparator;
import java.util.List;
import java.util.Locale;

final class FutureStore {
    static final String ACTION_FIRE = "com.alarm.application.FUTURE_FIRE";

    static final class Item {
        int id;
        String title = "";
        String note = "";
        long triggerAt;
        boolean done = false;

        JSONObject toJson() {
            JSONObject o = new JSONObject();
            try {
                o.put("id", id);
                o.put("title", title);
                o.put("note", note);
                o.put("triggerAt", triggerAt);
                o.put("done", done);
            } catch (Exception ignored) {}
            return o;
        }
        static Item fromJson(JSONObject o) {
            Item it = new Item();
            it.id = o.optInt("id");
            it.title = o.optString("title", "");
            it.note = o.optString("note", "");
            it.triggerAt = o.optLong("triggerAt", 0L);
            it.done = o.optBoolean("done", false);
            return it;
        }

        String dateTimeText() {
            Calendar c = Calendar.getInstance();
            c.setTimeInMillis(triggerAt);
            return String.format(Locale.US, "%04d-%02d-%02d %02d:%02d",
                    c.get(Calendar.YEAR), c.get(Calendar.MONTH) + 1,
                    c.get(Calendar.DAY_OF_MONTH), c.get(Calendar.HOUR_OF_DAY),
                    c.get(Calendar.MINUTE));
        }

        String remainText() {
            if (done) return "已完成知晓";
            long diff = triggerAt - System.currentTimeMillis();
            if (diff <= 0) return "待确认 · 持续提醒中";
            long days = diff / 86400000L;
            long hours = (diff % 86400000L) / 3600000L;
            long mins = Math.max(1, (diff % 3600000L) / 60000L);
            if (days > 0) return "还有 " + days + " 天 " + hours + " 小时";
            if (hours > 0) return "还有 " + hours + " 小时 " + mins + " 分钟";
            return "还有 " + mins + " 分钟";
        }
    }
    private static SharedPreferences sp(Context c) {
        return c.getSharedPreferences("future_list", Context.MODE_PRIVATE);
    }

    static List<Item> all(Context c) {
        List<Item> list = new ArrayList<Item>();
        try {
            JSONArray arr = new JSONArray(sp(c).getString("items", "[]"));
            for (int i = 0; i < arr.length(); i++) {
                list.add(Item.fromJson(arr.getJSONObject(i)));
            }
        } catch (Exception ignored) {}
        Collections.sort(list, new Comparator<Item>() {
            @Override
            public int compare(Item a, Item b) {
                if (a.done != b.done) return a.done ? 1 : -1;
                return a.triggerAt < b.triggerAt ? -1 : (a.triggerAt > b.triggerAt ? 1 : 0);
            }
        });
        return list;
    }

    static Item get(Context c, int id) {
        for (Item it : all(c)) {
            if (it.id == id) return it;
        }
        return null;
    }

    static int nextId(Context c) {
        int id = sp(c).getInt("nextId", 5001);
        sp(c).edit().putInt("nextId", id + 1).apply();
        return id;
    }

    private static void saveAll(Context c, List<Item> list) {
        JSONArray arr = new JSONArray();
        for (Item it : list) arr.put(it.toJson());
        sp(c).edit().putString("items", arr.toString()).apply();
    }
    static void upsert(Context c, Item item) {
        List<Item> list = all(c);
        boolean found = false;
        for (int i = 0; i < list.size(); i++) {
            if (list.get(i).id == item.id) {
                list.set(i, item);
                found = true;
                break;
            }
        }
        if (!found) list.add(item);
        saveAll(c, list);
        schedule(c, item);
    }

    static void delete(Context c, int id) {
        cancel(c, id);
        List<Item> list = all(c);
        for (int i = list.size() - 1; i >= 0; i--) {
            if (list.get(i).id == id) list.remove(i);
        }
        saveAll(c, list);
    }

    private static PendingIntent pi(Context c, int id) {
        Intent i = new Intent(c, BootReceiver.class)
                .setAction(ACTION_FIRE)
                .putExtra("future_id", id);
        int f = PendingIntent.FLAG_UPDATE_CURRENT;
        if (Build.VERSION.SDK_INT >= 23) f |= PendingIntent.FLAG_IMMUTABLE;
        return PendingIntent.getBroadcast(c, 900000 + id, i, f);
    }

    static void schedule(Context c, Item item) {
        AlarmManager am = (AlarmManager) c.getSystemService(Context.ALARM_SERVICE);
        if (am == null) return;
        am.cancel(pi(c, item.id));
        if (item.done) return;
        long when = Math.max(System.currentTimeMillis() + 5000L, item.triggerAt);
        int f = PendingIntent.FLAG_UPDATE_CURRENT;
        if (Build.VERSION.SDK_INT >= 23) f |= PendingIntent.FLAG_IMMUTABLE;
        PendingIntent show = PendingIntent.getActivity(c, 0, new Intent(c, FutureActivity.class), f);
        am.setAlarmClock(new AlarmManager.AlarmClockInfo(when, show), pi(c, item.id));
    }

    static void cancel(Context c, int id) {
        AlarmManager am = (AlarmManager) c.getSystemService(Context.ALARM_SERVICE);
        if (am != null) am.cancel(pi(c, id));
    }

    static void rescheduleAll(Context c) {
        for (Item it : all(c)) {
            if (!it.done) schedule(c, it);
        }
    }
}
