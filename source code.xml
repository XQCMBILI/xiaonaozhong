            "不错过每一份珍贵的牵挂", "跨越时间的郑重约定", "愿每个期许都如约而至",
            "记住爱与被爱的每个瞬间", "远方的事，替你稳稳守候", "岁岁年年，万喜万般宜"
        };
        private final LinearLayout center;

        FutureIntroView(Context c) {
            super(c);
            setOrientation(VERTICAL);
            setGravity(Gravity.CENTER);
            setClickable(true);
            setBackground(new GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,
                    new int[]{Tones.alpha(Ui.tertiaryC, 255), Tones.alpha(Ui.bg, 255)}));

