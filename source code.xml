package com.alarm.application;

import android.view.Gravity;
import android.view.View;
import android.widget.CompoundButton;
import android.widget.LinearLayout;
import android.widget.Switch;
import android.widget.TextView;

final class AlarmCard {
    static View build(final MainActivity act, final Alarm a) {
        LinearLayout card = new LinearLayout(act);
        card.setOrientation(LinearLayout.HORIZONTAL);
        card.setGravity(Gravity.CENTER_VERTICAL);
        card.setBackground(Ui.ripple(Ui.shape(act, Ui.surface, 30)));
        card.setPadding(Ui.dp(act, 24), Ui.dp(act, 18), Ui.dp(act, 18), Ui.dp(act, 18));
        card.setAlpha(a.enabled ? 1f : .6f);

        LinearLayout left = new LinearLayout(act);
        left.setOrientation(LinearLayout.VERTICAL);
        LinearLayout row = new LinearLayout(act);
        row.setOrientation(LinearLayout.HORIZONTAL);
        row.setGravity(Gravity.BOTTOM);
        TextView ap = Ui.tv(act, TimeText.period(a.hour), 14, Ui.textVar, "sans-serif-medium");
        ap.setPadding(0, 0, Ui.dp(act, 8), Ui.dp(act, 8));
        TextView tm = Ui.tv(act, TimeText.hms(a), a.second > 0 ? 38 : 48, Ui.text, "sans-serif-light");
        row.addView(ap);
        row.addView(tm);
        String sub = (a.label.isEmpty() ? "" : a.label + " · ") + a.repeatText();
        TextView st = Ui.tv(act, sub, 14, Ui.textVar, "sans-serif");
        st.setPadding(0, Ui.dp(act, 4), 0, 0);
        left.addView(row);
        left.addView(st);
        card.addView(left, new LinearLayout.LayoutParams(0, Widgets.WRAP, 1f));

        Switch sw = Widgets.makeSwitch(act, a.enabled);
        sw.setOnCheckedChangeListener(new CompoundButton.OnCheckedChangeListener() {
            @Override
            public void onCheckedChanged(CompoundButton b, boolean on) {
                a.enabled = on;
                AlarmStore.upsert(act, a);
                AlarmScheduler.schedule(act, a);
                if (on) {
                    act.toast("将在 " + TimeText.until(a.nextTrigger()) + "后响铃");
                } else {
                    AlarmScheduler.cancel(act, a.id, true);
                }
                act.postRefresh();
            }
        });
        card.addView(sw);
        card.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                act.edit(a);
            }
        });
        return card;
    }
}
