package com.alarm.application;

import android.app.AlarmManager;
import android.app.PendingIntent;
import android.content.Context;
import android.content.Intent;
import android.content.SharedPreferences;
import android.os.Build;

import java.util.Calendar;

final class Bedtime {
    private static SharedPreferences sp(Context c) {
        return c.getSharedPreferences("bedtime", Context.MODE_PRIVATE);
    }

    static boolean on(Context c) {
        return sp(c).getBoolean("on", false);
    }

    static int hour(Context c) {
        return sp(c).getInt("h", 22);
    }

    static int minute(Context c) {
        return sp(c).getInt("m", 30);
    }

    static void setOn(Context c, boolean v) {
        sp(c).edit().putBoolean("on", v).apply();
        schedule(c);
    }

    static void setTime(Context c, int h, int m) {
        sp(c).edit().putInt("h", h).putInt("m", m).putBoolean("on", true).apply();
        schedule(c);
    }

    private static PendingIntent pi(Context c) {
        Intent i = new Intent(c, BedtimeReceiver.class).setAction("com.alarm.application.BEDTIME");
        int f = PendingIntent.FLAG_UPDATE_CURRENT;
        if (Build.VERSION.SDK_INT >= 23) f |= PendingIntent.FLAG_IMMUTABLE;
        return PendingIntent.getBroadcast(c, 777777, i, f);
    }

    private static void set(Context c, long when) {
        AlarmManager am = (AlarmManager) c.getSystemService(Context.ALARM_SERVICE);
        // 核心改动：采用和主闹钟完全等效的 setAlarmClock，获取最高系统特权，突破杀后台限制
        int f = PendingIntent.FLAG_UPDATE_CURRENT;
        if (Build.VERSION.SDK_INT >= 23) f |= PendingIntent.FLAG_IMMUTABLE;
        PendingIntent show = PendingIntent.getActivity(c, 0, new Intent(c, MainActivity.class), f);
        am.setAlarmClock(new AlarmManager.AlarmClockInfo(when, show), pi(c));
    }

    static void schedule(Context c) {
        AlarmManager am = (AlarmManager) c.getSystemService(Context.ALARM_SERVICE);
        am.cancel(pi(c));
        if (!on(c)) return;
        Calendar t = Calendar.getInstance();
        t.set(Calendar.HOUR_OF_DAY, hour(c));
        t.set(Calendar.MINUTE, minute(c));
        t.set(Calendar.SECOND, 0);
        t.set(Calendar.MILLISECOND, 0);
        if (t.getTimeInMillis() <= System.currentTimeMillis()) t.add(Calendar.DAY_OF_YEAR, 1);
        set(c, t.getTimeInMillis());
    }

    static void later(Context c) {
        set(c, System.currentTimeMillis() + 10 * 60 * 1000L);
    }
}
