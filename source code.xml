import java.util.List;

final class HeroCard {
    private TextView day;
    private TextView sub;

    LinearLayout build(Context c) {
        LinearLayout hero = new LinearLayout(c);
        hero.setOrientation(LinearLayout.VERTICAL);
        hero.setBackground(Ui.shape(c, Ui.primaryC, 36));
        hero.setPadding(Ui.dp(c, 26), Ui.dp(c, 24), Ui.dp(c, 26), Ui.dp(c, 26));
        TextView hl = Ui.tv(c, "下一个闹钟", 14, Ui.onPrimaryC, "sans-serif-medium");
        hl.setAlpha(.75f);
        day = Ui.tv(c, "", 38, Ui.onPrimaryC, "sans-serif-light");
        day.setPadding(0, Ui.dp(c, 8), 0, Ui.dp(c, 6));
        sub = Ui.tv(c, "", 15, Ui.onPrimaryC, "sans-serif");
        hero.addView(hl);
        hero.addView(day);
        hero.addView(sub);
        return hero;
    }

    void update(List<Alarm> alarms) {
        long best = -1;
        for (Alarm a : alarms) {
            if (!a.enabled) continue;
            long t = a.nextTrigger();
            if (t > 0 && (best < 0 || t < best)) best = t;
        }
        if (best < 0) {
            day.setText("未设置");
            sub.setText("没有开启的闹钟");
            return;
        }
        day.setText(TimeText.dayLabel(best) + " " + TimeText.clock(best));
        sub.setText("还有 " + TimeText.until(best));
    }
}
