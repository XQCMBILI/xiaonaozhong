<file path="小闹钟/app/src/main/java/com/alarm/application/FluidView.java">
package com.alarm.application;

import android.content.Context;
import android.graphics.Canvas;
import android.graphics.Paint;
import android.graphics.RadialGradient;
import android.graphics.Shader;
import android.view.View;

public class FluidView extends View {
    private static final float[][] BLOBS = {
            {0.15f, 0.12f, 0.75f, 1, 2, 0.00f},
            {0.85f, 0.25f, 0.70f, 2, 1, 0.20f},
            {0.30f, 0.60f, 0.80f, 1, 1, 0.45f},
            {0.80f, 0.80f, 0.75f, 2, 3, 0.65f},
            {0.10f, 0.95f, 0.65f, 3, 2, 0.85f}
    };
    private static final float[] OFFS = {-40f, 0f, 40f, 80f, 120f};

    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
    private final int[] colors = new int[5];
    private float t;

    // 核心改动：弃用容易被系统接管和禁用的 ValueAnimator，改用高频帧绘制循环
    private final Runnable ticker = new Runnable() {
        @Override
        public void run() {
            t += 0.004f; // 调整参数，确保动效肉眼可见且流畅
            if (t > 1f) t -= 1f;
            invalidate();
            postOnAnimation(this);
        }
    };

    public FluidView(Context c) {
        super(c);
        Ui.init(c);
        if (Theme.gradStyle == 0) {
            colors[0] = 0xFF4796E3;
            colors[1] = 0xFF9177C7;
            colors[2] = 0xFFCA6673;
            colors[3] = 0xFF6FB1F7;
            colors[4] = 0xFFE8A0B4;
        } else {
            float h = Tones.hueOf(Theme.seed);
            float l = Ui.dark ? 0.50f : 0.66f;
            for (int i = 0; i < 5; i++) colors[i] = Tones.hsl(h + OFFS[i], 0.80f, l);
        }
    }

    @Override
    protected void onAttachedToWindow() {
        super.onAttachedToWindow();
        postOnAnimation(ticker);
    }

    @Override
    protected void onDetachedFromWindow() {
        removeCallbacks(ticker);
        super.onDetachedFromWindow();
    }

    @Override
    protected void onDraw(Canvas canvas) {
        float w = getWidth();
        float h = getHeight();
        canvas.drawColor(Ui.bg);
        float big = Math.max(w, h);
        int a = Ui.dark ? 0x99 : 0xA6;
        double two = Math.PI * 2;
        for (int i = 0; i < BLOBS.length; i++) {
            float[] b = BLOBS[i];
            float cx = w * b[0] + w * 0.22f * (float) Math.sin(two * (t * b[3] + b[5]));
            float cy = h * b[1] + h * 0.14f * (float) Math.cos(two * (t * b[4] + b[5]));
            float r = big * b[2] * 0.62f;
            paint.setShader(new RadialGradient(cx, cy, r,
                    Tones.alpha(colors[i], a), Tones.alpha(colors[i], 0), Shader.TileMode.CLAMP));
            canvas.drawCircle(cx, cy, r, paint);
        }
    }
}
