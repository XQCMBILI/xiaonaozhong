package com.alarm.application;

import android.graphics.Color;

final class Tones {
    static int hsl(float h, float s, float l) {
        h = ((h % 360f) + 360f) % 360f;
        float c = (1f - Math.abs(2f * l - 1f)) * s;
        float x = c * (1f - Math.abs((h / 60f) % 2f - 1f));
        float m = l - c / 2f;
        float r = 0, g = 0, b = 0;
        if (h < 60) { r = c; g = x; }
        else if (h < 120) { r = x; g = c; }
        else if (h < 180) { g = c; b = x; }
        else if (h < 240) { g = x; b = c; }
        else if (h < 300) { r = x; b = c; }
        else { r = c; b = x; }
        int ri = Math.round((r + m) * 255f);
        int gi = Math.round((g + m) * 255f);
        int bi = Math.round((b + m) * 255f);
        return 0xFF000000 | (ri << 16) | (gi << 8) | bi;
    }

    static float hueOf(int color) {
        float[] hsv = new float[3];
        Color.colorToHSV(color, hsv);
        return hsv[0];
    }

    static float satOf(int color) {
        float[] hsv = new float[3];
        Color.colorToHSV(color, hsv);
        return Math.max(0.35f, Math.min(0.85f, hsv[1]));
    }

    static int alpha(int color, int a) {
        return (a << 24) | (color & 0x00FFFFFF);
    }
    static void fill(boolean dark) {
        float h = hueOf(Theme.seed);
        float s = satOf(Theme.seed);
        if (dark) {
            Ui.bg = hsl(h, 0.18f, 0.07f);
            Ui.surface = hsl(h, 0.16f, 0.13f);
            Ui.text = hsl(h, 0.12f, 0.92f);
            Ui.textVar = hsl(h, 0.10f, 0.68f);
            Ui.primary = hsl(h, s, 0.80f);
            Ui.onPrimary = hsl(h, s, 0.17f);
            Ui.primaryC = hsl(h, s * 0.8f, 0.28f);
            Ui.onPrimaryC = hsl(h, s, 0.90f);
            Ui.tertiaryC = hsl(h + 55f, 0.40f, 0.26f);
            Ui.onTertiaryC = hsl(h + 55f, 0.70f, 0.90f);
            Ui.secondaryC = hsl(h + 120f, 0.35f, 0.24f);
            Ui.outline = hsl(h, 0.12f, 0.24f);
            Ui.error = 0xFFFFB4AB;
        } else {
            Ui.bg = hsl(h, 0.60f, 0.975f);
            Ui.surface = hsl(h, 0.40f, 0.94f);
            Ui.text = hsl(h, 0.20f, 0.10f);
            Ui.textVar = hsl(h, 0.10f, 0.40f);
            Ui.primary = hsl(h, s, 0.38f);
            Ui.onPrimary = 0xFFFFFFFF;
            Ui.primaryC = hsl(h, s * 0.9f, 0.90f);
            Ui.onPrimaryC = hsl(h, s, 0.14f);
            Ui.tertiaryC = hsl(h + 55f, 0.75f, 0.88f);
            Ui.onTertiaryC = hsl(h + 55f, 0.60f, 0.18f);
            Ui.secondaryC = hsl(h + 120f, 0.50f, 0.86f);
            Ui.outline = hsl(h, 0.30f, 0.88f);
            Ui.error = 0xFFB3261E;
        }
        if (Theme.gradient) {
            Ui.surface = alpha(Ui.surface, 0xD0);
            Ui.primaryC = alpha(Ui.primaryC, 0xE0);
        }
    }
}
