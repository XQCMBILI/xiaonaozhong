package com.alarm.application;

import android.app.Dialog;
import android.content.Context;
import android.graphics.Color;
import android.graphics.Typeface;
import android.graphics.drawable.ColorDrawable;
import android.view.Gravity;
import android.view.View;
import android.view.Window;
import android.widget.LinearLayout;
import android.widget.TextView;

final class PixelDialog {
    private static Dialog base(Context c, LinearLayout box) {
        Dialog d = new Dialog(c);
        d.requestWindowFeature(Window.FEATURE_NO_TITLE);
        d.setContentView(box);
        Window w = d.getWindow();
        if (w != null) {
            w.setBackgroundDrawable(new ColorDrawable(Color.TRANSPARENT));
            int width = (int) (c.getResources().getDisplayMetrics().widthPixels * 0.88f);
            w.setLayout(width, Widgets.WRAP);
            w.setDimAmount(0.45f);
        }
        return d;
    }

    static void confirm(Context c, String titleStr, String msgStr,
                        String negText, String posText, boolean danger, final Runnable onPos) {
        LinearLayout box = new LinearLayout(c);
        box.setOrientation(LinearLayout.VERTICAL);
        box.setPadding(Ui.dp(c, 24), Ui.dp(c, 24), Ui.dp(c, 24), Ui.dp(c, 20));
        box.setBackground(Ui.shape(c, Ui.dark ? 0xFF2B2930 : 0xFFF7F2FA, 28));

        if (titleStr != null && !titleStr.isEmpty()) {
            TextView title = Ui.tv(c, titleStr, 22, Ui.text, "sans-serif");
            title.setTypeface(Typeface.create("sans-serif-medium", Typeface.NORMAL));
            title.setPadding(0, 0, 0, Ui.dp(c, 14));
            box.addView(title);
        }

        TextView msg = Ui.tv(c, msgStr, 15, Ui.textVar, "sans-serif");
        msg.setLineSpacing(Ui.dp(c, 3), 1.15f);
        box.addView(msg);

        LinearLayout btns = new LinearLayout(c);
        btns.setOrientation(LinearLayout.HORIZONTAL);
        btns.setGravity(Gravity.END | Gravity.CENTER_VERTICAL);
        btns.setPadding(0, Ui.dp(c, 24), 0, 0);

        final Dialog d = base(c, box);
        TextView cancel = Ui.tv(c, negText, 14, Ui.primary, "sans-serif-medium");
        cancel.setPadding(Ui.dp(c, 18), Ui.dp(c, 10), Ui.dp(c, 18), Ui.dp(c, 10));
        cancel.setBackground(Ui.ripple(Ui.shape(c, Color.TRANSPARENT, 20)));
        cancel.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                d.dismiss();
            }
        });

        int posBg = danger ? Ui.error : Ui.primary;
        int posFg = danger ? (Ui.dark ? 0xFF601410 : 0xFFFFFFFF) : Ui.onPrimary;
        TextView ok = Ui.tv(c, posText, 14, posFg, "sans-serif-medium");
        ok.setPadding(Ui.dp(c, 22), Ui.dp(c, 10), Ui.dp(c, 22), Ui.dp(c, 10));
        ok.setBackground(Ui.ripple(Ui.shape(c, posBg, 20)));
        ok.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                d.dismiss();
                if (onPos != null) onPos.run();
            }
        });

        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(Widgets.WRAP, Widgets.WRAP);
        lp.leftMargin = Ui.dp(c, 8);
        btns.addView(cancel);
        btns.addView(ok, lp);
        box.addView(btns);
        d.show();
    }

    static void list(Context c, String titleStr, String[] items, final Widgets.IntCb cb) {
        LinearLayout box = new LinearLayout(c);
        box.setOrientation(LinearLayout.VERTICAL);
        box.setPadding(Ui.dp(c, 20), Ui.dp(c, 24), Ui.dp(c, 20), Ui.dp(c, 16));
        box.setBackground(Ui.shape(c, Ui.dark ? 0xFF2B2930 : 0xFFF7F2FA, 28));

        TextView title = Ui.tv(c, titleStr, 22, Ui.text, "sans-serif-medium");
        title.setPadding(Ui.dp(c, 8), 0, Ui.dp(c, 8), Ui.dp(c, 12));
        box.addView(title);

        final Dialog d = base(c, box);

        for (int i = 0; i < items.length; i++) {
            final int idx = i;
            LinearLayout row = new LinearLayout(c);
            row.setOrientation(LinearLayout.HORIZONTAL);
            row.setGravity(Gravity.CENTER_VERTICAL);
            row.setPadding(Ui.dp(c, 16), Ui.dp(c, 16), Ui.dp(c, 16), Ui.dp(c, 16));
            row.setBackground(Ui.ripple(Ui.shape(c, Ui.surface, 18)));

            TextView dot = Ui.tv(c, "●", 12, Ui.primary, "sans-serif");
            dot.setPadding(0, 0, Ui.dp(c, 14), 0);
            row.addView(dot);

            TextView tv = Ui.tv(c, items[i], 16, Ui.text, "sans-serif-medium");
            row.addView(tv, new LinearLayout.LayoutParams(0, Widgets.WRAP, 1f));

            row.setOnClickListener(new View.OnClickListener() {
                @Override
                public void onClick(View v) {
                    d.dismiss();
                    if (cb != null) cb.on(idx);
                }
            });
            LinearLayout.LayoutParams rp = new LinearLayout.LayoutParams(Widgets.MATCH, Widgets.WRAP);
            rp.bottomMargin = Ui.dp(c, 8);
            box.addView(row, rp);
        }

        LinearLayout btns = new LinearLayout(c);
        btns.setGravity(Gravity.END);
        btns.setPadding(0, Ui.dp(c, 4), 0, 0);
        TextView cancel = Ui.tv(c, "取消", 14, Ui.primary, "sans-serif-medium");
        cancel.setPadding(Ui.dp(c, 18), Ui.dp(c, 10), Ui.dp(c, 18), Ui.dp(c, 10));
        cancel.setBackground(Ui.ripple(Ui.shape(c, Color.TRANSPARENT, 20)));
        cancel.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                d.dismiss();
            }
        });
        btns.addView(cancel);
        box.addView(btns);
        d.show();
    }
}
