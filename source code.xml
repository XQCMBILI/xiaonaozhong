package com.alarm.application;

import android.app.Dialog;
import android.view.Gravity;
import android.view.View;
import android.widget.EditText;
import android.widget.LinearLayout;
import android.widget.TextView;
import android.widget.TimePicker;

final class EditorBar {
    static LinearLayout build(final MainActivity act, final Dialog dlg, final Alarm d,
                              final TimePicker tp, final SecondRow sec, final EditText et,
                              boolean isNew) {
        LinearLayout bar = new LinearLayout(act);
        bar.setOrientation(LinearLayout.HORIZONTAL);
        bar.setGravity(Gravity.CENTER_VERTICAL);
        if (!isNew) bar.addView(deleteButton(act, dlg, d));
        bar.addView(new View(act), new LinearLayout.LayoutParams(0, 1, 1f));

        TextView cancel = Ui.tv(act, "取消", 16, Ui.primary, "sans-serif-medium");
        cancel.setPadding(Ui.dp(act, 20), Ui.dp(act, 16), Ui.dp(act, 20), Ui.dp(act, 16));
        cancel.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                dlg.dismiss();
            }
        });

        TextView save = Ui.tv(act, "保存", 16, Ui.onPrimary, "sans-serif-medium");
        save.setGravity(Gravity.CENTER);
        save.setBackground(Ui.ripple(Ui.shape(act, Ui.primary, 28)));
        save.setPadding(Ui.dp(act, 36), Ui.dp(act, 16), Ui.dp(act, 36), Ui.dp(act, 16));
        save.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                d.hour = tp.getCurrentHour();
                d.minute = tp.getCurrentMinute();
                d.second = sec.value();
                d.label = et.getText().toString().trim();
                d.enabled = true;
                if (d.id == 0) d.id = AlarmStore.nextId(act);
                AlarmStore.upsert(act, d);
                AlarmScheduler.schedule(act, d);
                AlarmScheduler.cancel(act, d.id, true);
                dlg.dismiss();
                LoadingOverlay.show(act, "正在保存…", 700, new Runnable() {
                    @Override
                    public void run() {
                        act.toast("将在 " + TimeText.until(d.nextTrigger()) + "后响铃");
                        act.refresh();
                    }
                });
            }
        });
        bar.addView(cancel);
        bar.addView(save);
        return bar;
    }

    private static TextView deleteButton(final MainActivity act, final Dialog dlg, final Alarm d) {
        TextView del = Ui.tv(act, "删除", 16, Ui.error, "sans-serif-medium");
        del.setPadding(Ui.dp(act, 16), Ui.dp(act, 16), Ui.dp(act, 16), Ui.dp(act, 16));
        del.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                PixelDialog.confirm(act, "删除闹钟", "确定要删除这个闹钟吗？",
                        "取消", "删除", true, new Runnable() {
                            @Override
                            public void run() {
                                AlarmScheduler.cancel(act, d.id, false);
                                AlarmScheduler.cancel(act, d.id, true);
                                AlarmStore.delete(act, d.id);
                                dlg.dismiss();
                                act.refresh();
                            }
                        });
            }
        });
        return del;
    }
}
