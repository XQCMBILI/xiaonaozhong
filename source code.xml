package com.alarm.application;

import android.content.Context;
import android.view.Gravity;
import android.view.View;
import android.widget.LinearLayout;
import android.widget.TextView;

final class Swatches {
    static final int[] COLORS = {0xFF7A2FA3, 0xFF1A73E8, 0xFF00897B, 0xFF34A853,
            0xFFF29900, 0xFFD93025, 0xFFD6479B, 0xFF607D8B};

    private final Context c;
    private final int[] pick;
    private final TextView[] dots = new TextView[COLORS.length];

    Swatches(Context c, int[] pick) {
        this.c = c;
        this.pick = pick;
    }

    View build() {
        LinearLayout box = new LinearLayout(c);
        box.setOrientation(LinearLayout.VERTICAL);
        LinearLayout row = new LinearLayout(c);
        for (int i = 0; i < COLORS.length; i++) {
            final int idx = i;
            TextView t = Ui.tv(c, "", 16, 0xFFFFFFFF, "sans-serif-medium");
            t.setGravity(Gravity.CENTER);
            t.setBackground(Ui.oval(COLORS[i]));
            dots[i] = t;
            t.setOnClickListener(new View.OnClickListener() {
                @Override
                public void onClick(View v) {
                    pick[0] = COLORS[idx];
                    mark();
                }
            });
            LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(0, Ui.dp(c, 38), 1f);
            if (i < COLORS.length - 1) p.rightMargin = Ui.dp(c, 6);
            row.addView(t, p);
        }
        box.addView(row);
        mark();
        return box;
    }

    private void mark() {
        for (int i = 0; i < COLORS.length; i++) {
            dots[i].setText(pick[0] == COLORS[i] ? "✓" : "");
        }
    }
}
