        private void addRow(Context c, int st, int dir, float sp, int a, float spd, float ph) {
            addView(new Row(c, st, dir, sp, a, spd, ph), new LayoutParams(Widgets.MATCH, Ui.dp(c, sp + 26)));
        }

        @Override
        protected void onAttachedToWindow() {
            super.onAttachedToWindow();
            center.animate().alpha(1f).scaleX(1f).scaleY(1f).setStartDelay(180).setDuration(650).start();
        }

        private static final class Row extends View {
            private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
            private final String unit;
            private final int dir;
            private final float speed, phase, unitW;
            private final long t0 = SystemClock.uptimeMillis();

            Row(Context c, int st, int d, float sp, int alpha, float spd, float ph) {
                super(c);
                float dens = c.getResources().getDisplayMetrics().density;
                dir = d; speed = spd * dens; phase = ph * dens;
                p.setTextSize(sp * dens);
                p.setTypeface(Typeface.create("sans-serif-medium", Typeface.NORMAL));
                p.setColor(Ui.primary);
                p.setAlpha(alpha);
                StringBuilder sb = new StringBuilder();
                for (int i = 0; i < WORDS.length; i++) {
                    sb.append(WORDS[(st + i) % WORDS.length]).append("      ·      ");
                }
                unit = sb.toString();
                unitW = p.measureText(unit);
            }

            @Override
            protected void onDraw(Canvas canvas) {
                if (unitW <= 0) return;
                float t = (SystemClock.uptimeMillis() - t0) / 1000f;
                float x = (phase + t * speed * dir) % unitW;
                if (x > 0) x -= unitW;
                float base = getHeight() / 2f - (p.ascent() + p.descent()) / 2f;
                while (x < getWidth()) {
                    canvas.drawText(unit, x, base, p);
                    x += unitW;
                }
                postInvalidateOnAnimation();
            }
        }
    }
}
