import android.view.View;
import android.view.ViewGroup;
import android.view.animation.OvershootInterpolator;
import android.widget.CompoundButton;
import android.widget.LinearLayout;
import android.widget.Switch;
import android.widget.TextView;

final class Widgets {
    static final int MATCH = ViewGroup.LayoutParams.MATCH_PARENT;
    static final int WRAP = ViewGroup.LayoutParams.WRAP_CONTENT;

    interface IntCb {
        void on(int i);
    }

    interface BoolCb {
        void on(boolean b);
    }

    static Switch makeSwitch(final Context c, boolean on) {
        Switch s = new Switch(c) {
            private float frac = isChecked() ? 1f : 0f;
            private ValueAnimator anim;
            private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
            private final RectF trackRect = new RectF();

            @Override
            public void setChecked(boolean checked) {
                boolean changed = (checked != isChecked());
                super.setChecked(checked);
                if (changed && isAttachedToWindow()) {
                    if (anim != null) anim.cancel();
                    anim = ValueAnimator.ofFloat(frac, checked ? 1f : 0f);
                    anim.setDuration(220);
                    anim.setInterpolator(new OvershootInterpolator(1.2f));
                    anim.addUpdateListener(new ValueAnimator.AnimatorUpdateListener() {
                        @Override
                        public void onAnimationUpdate(ValueAnimator a) {
                            frac = (Float) a.getAnimatedValue();
                            invalidate();
                        }
                    });
                    anim.start();
                } else {
                    frac = checked ? 1f : 0f;
                    invalidate();
                }
            }

            @Override
            protected void onDraw(Canvas canvas) {
                float w = getWidth();
                float h = getHeight();
                float cy = h / 2f;

                float trackH = Ui.dp(c, 14);
                float trackW = Ui.dp(c, 36);
                float trackLeft = (w - trackW) / 2f;
                trackRect.set(trackLeft, cy - trackH / 2f, trackLeft + trackW, cy + trackH / 2f);

                int offTrack = Tones.alpha(Ui.textVar, Ui.dark ? 0x45 : 0x38);
                int onTrack = Tones.alpha(Ui.primary, Ui.dark ? 0x80 : 0x70);
                p.setStyle(Paint.Style.FILL);
                p.setColor(blend(offTrack, onTrack, frac));
                canvas.drawRoundRect(trackRect, trackH / 2f, trackH / 2f, p);

                float thumbR = Ui.dp(c, 10);
                float startX = trackLeft + Ui.dp(c, 7);
                float endX = trackLeft + trackW - Ui.dp(c, 7);
                float cx = startX + (endX - startX) * frac;

                p.setColor(0x22000000);
                canvas.drawCircle(cx, cy + Ui.dp(c, 1f), thumbR, p);

                int offThumb = Ui.dark ? Ui.textVar : 0xFF65606B;
                int onThumb = Ui.dark ? Ui.primary : 0xFFFFFFFF;
                p.setColor(blend(offThumb, onThumb, frac));
                canvas.drawCircle(cx, cy, thumbR, p);
            }
        };
        s.setBackground(null);
        s.setClickable(true);
        s.setChecked(on);
        return s;
    }
    private static int blend(int c1, int c2, float f) {
        f = Math.max(0f, Math.min(1f, f));
        int a1 = (c1 >>> 24) & 0xFF, r1 = (c1 >> 16) & 0xFF, g1 = (c1 >> 8) & 0xFF, b1 = c1 & 0xFF;
        int a2 = (c2 >>> 24) & 0xFF, r2 = (c2 >> 16) & 0xFF, g2 = (c2 >> 8) & 0xFF, b2 = c2 & 0xFF;
        int a = Math.round(a1 + (a2 - a1) * f);
        int r = Math.round(r1 + (r2 - r1) * f);
        int g = Math.round(g1 + (g2 - g1) * f);
        int b = Math.round(b1 + (b2 - b1) * f);
        return (a << 24) | (r << 16) | (g << 8) | b;
    }

    static TextView sectionLabel(Context c, String s) {
        TextView t = Ui.tv(c, s, 13, Ui.textVar, "sans-serif-medium");
        t.setPadding(Ui.dp(c, 4), Ui.dp(c, 20), 0, Ui.dp(c, 8));
        return t;
    }

    static void styleChips(Context c, TextView[] t, int sel) {
        for (int i = 0; i < t.length; i++) {
            boolean on = i == sel;
            t[i].setBackground(Ui.shape(c, on ? Ui.primary : Ui.surface, on ? 24 : 12));
            t[i].setTextColor(on ? Ui.onPrimary : Ui.text);
        }
    }

    static LinearLayout chipRow(final Context c, String[] labels, int sel, final IntCb cb) {
        LinearLayout r = new LinearLayout(c);
        r.setOrientation(LinearLayout.HORIZONTAL);
        final TextView[] tvs = new TextView[labels.length];
        for (int i = 0; i < labels.length; i++) {
            final int idx = i;
            TextView t = Ui.tv(c, labels[i], 14, Ui.text, "sans-serif-medium");
            t.setGravity(Gravity.CENTER);
            t.setPadding(0, Ui.dp(c, 13), 0, Ui.dp(c, 13));
            tvs[i] = t;
            t.setOnClickListener(new View.OnClickListener() {
                @Override
                public void onClick(View v) {
                    styleChips(c, tvs, idx);
                    cb.on(idx);
                }
            });
            LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(0, WRAP, 1f);
            if (i < labels.length - 1) p.rightMargin = Ui.dp(c, 6);
            r.addView(t, p);
        }
        styleChips(c, tvs, sel);
        return r;
    }
    static LinearLayout switchRow(Context c, String title, String sub, boolean on, final BoolCb cb) {
        LinearLayout r = new LinearLayout(c);
        r.setOrientation(LinearLayout.HORIZONTAL);
        r.setGravity(Gravity.CENTER_VERTICAL);
        r.setBackground(Ui.shape(c, Ui.surface, 24));
        r.setPadding(Ui.dp(c, 20), Ui.dp(c, 14), Ui.dp(c, 14), Ui.dp(c, 14));
        LinearLayout tx = new LinearLayout(c);
        tx.setOrientation(LinearLayout.VERTICAL);
        tx.addView(Ui.tv(c, title, 16, Ui.text, "sans-serif-medium"));
        TextView s = Ui.tv(c, sub, 13, Ui.textVar, "sans-serif");
        s.setPadding(0, Ui.dp(c, 2), 0, 0);
        tx.addView(s);
        r.addView(tx, new LinearLayout.LayoutParams(0, WRAP, 1f));
        final Switch sw = makeSwitch(c, on);
        sw.setOnCheckedChangeListener(new CompoundButton.OnCheckedChangeListener() {
            @Override
            public void onCheckedChanged(CompoundButton b, boolean v) {
                cb.on(v);
            }
        });
        r.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                sw.setChecked(!sw.isChecked());
            }
        });
        r.addView(sw);
        return r;
    }
}
