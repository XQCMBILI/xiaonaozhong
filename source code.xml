            window.setDimAmount(0.45f);
        }
        dialog.show();
    }

    private static void open(MainActivity act, int i) {
        Uri pkg = Uri.parse("package:" + act.getPackageName());
        Intent it;
        if (i == 0) {
            it = new Intent(Settings.ACTION_MANAGE_OVERLAY_PERMISSION, pkg);
        } else if (i == 1) {
            it = new Intent("android.settings.MANAGE_APP_USE_FULL_SCREEN_INTENT", pkg);
        } else if (i == 2) {
            it = new Intent("android.settings.APP_NOTIFICATION_SETTINGS");
            it.putExtra("android.provider.extra.APP_PACKAGE", act.getPackageName());
        } else if (i == 3) {
            it = new Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS, pkg);
            act.toast("进入「权限」→「其他权限」，打开：锁屏显示、后台弹出界面、自启动");
        } else {
            it = new Intent("android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS");
        }
        try {
            act.startActivity(it);
        } catch (Exception e) {
            try {
                act.startActivity(new Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS, pkg));
            } catch (Exception ignored) {
            }
        }
    }
}
