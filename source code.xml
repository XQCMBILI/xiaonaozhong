package com.alarm.application;

import android.app.Activity;
import android.app.Dialog;
import android.content.Context;
import android.graphics.Canvas;
import android.graphics.Paint;
import android.graphics.Typeface;
import android.graphics.drawable.GradientDrawable;
import android.os.Build;
import android.os.Bundle;
import android.os.Handler;
import android.os.SystemClock;
import android.view.Gravity;
import android.view.View;
import android.view.ViewGroup;
import android.view.Window;
import android.widget.EditText;
import android.widget.FrameLayout;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;
import android.widget.Toast;

import java.util.Calendar;
import java.util.List;
import java.util.Locale;

public class FutureActivity extends Activity {
    private final Handler h = new Handler();
    private FutureIntroView intro;
    private ScrollView mainScroll;
    private LinearLayout listContainer;
    private final Runnable hideIntro = new Runnable() {
        @Override
        public void run() { closeIntro(); }
    };

    private int dp(float v) { return Ui.dp(this, v); }
    @Override
    protected void onCreate(Bundle b) {
        super.onCreate(b);
        Ui.init(this);
        Window w = getWindow();
        int fl = View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN
                | View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION
                | View.SYSTEM_UI_FLAG_LAYOUT_STABLE;
        if (!Ui.dark) {
            if (Build.VERSION.SDK_INT >= 23) fl |= View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR;
            if (Build.VERSION.SDK_INT >= 26) fl |= View.SYSTEM_UI_FLAG_LIGHT_NAVIGATION_BAR;
        }
        w.getDecorView().setSystemUiVisibility(fl);
        w.addFlags(android.view.WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS);
        w.setStatusBarColor(android.graphics.Color.TRANSPARENT);
        w.setNavigationBarColor(android.graphics.Color.TRANSPARENT);

        FrameLayout root = new FrameLayout(this);
        root.setBackgroundColor(Ui.bg);
        if (Theme.gradient) {
            root.addView(new FluidView(this), new FrameLayout.LayoutParams(Widgets.MATCH, Widgets.MATCH));
        }

        mainScroll = new ScrollView(this);
        mainScroll.setOverScrollMode(View.OVER_SCROLL_NEVER);
        LinearLayout col = new LinearLayout(this);
        col.setOrientation(LinearLayout.VERTICAL);
        col.setPadding(dp(20), dp(56), dp(20), dp(130));

        col.addView(header());
        col.addView(bannerCard());
        listContainer = new LinearLayout(this);
        listContainer.setOrientation(LinearLayout.VERTICAL);
        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(Widgets.MATCH, Widgets.WRAP);
        lp.topMargin = dp(18);
        col.addView(listContainer, lp);

        mainScroll.addView(col, new ViewGroup.LayoutParams(Widgets.MATCH, Widgets.WRAP));
        root.addView(mainScroll, new FrameLayout.LayoutParams(Widgets.MATCH, Widgets.MATCH));
        root.addView(addFab(), fabParams());
        setContentView(root);
        refreshList();

        if (b == null) {
            mainScroll.setAlpha(0f);
            intro = new FutureIntroView(this);
            intro.setOnClickListener(new View.OnClickListener() {
                @Override
                public void onClick(View v) { closeIntro(); }
            });
            root.addView(intro, new FrameLayout.LayoutParams(Widgets.MATCH, Widgets.MATCH));
            h.postDelayed(hideIntro, 2400);
        }
    }
    private void closeIntro() {
        if (intro == null) return;
        final View v = intro;
        intro = null;
        h.removeCallbacks(hideIntro);
        v.animate().alpha(0f).setDuration(350).withEndAction(new Runnable() {
            @Override
            public void run() {
                if (v.getParent() instanceof ViewGroup) ((ViewGroup) v.getParent()).removeView(v);
            }
        }).start();
        if (mainScroll != null) {
            mainScroll.animate().alpha(1f).setStartDelay(120).setDuration(350).start();
        }
    }

    @Override
    protected void onResume() {
        super.onResume();
        refreshList();
    }

    @Override
    protected void onDestroy() {
        h.removeCallbacks(hideIntro);
        super.onDestroy();
    }

    private View header() {
        LinearLayout row = new LinearLayout(this);
        row.setGravity(Gravity.CENTER_VERTICAL);
        row.setPadding(dp(4), dp(12), 0, dp(16));
        TextView back = Ui.tv(this, "←", 22, Ui.text, "sans-serif-medium");
        back.setGravity(Gravity.CENTER);
        back.setBackground(Ui.ripple(Ui.shape(this, Ui.primaryC, 20)));
        back.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) { finish(); }
        });
        int size = dp(52);
        row.addView(back, new LinearLayout.LayoutParams(size, size));
        TextView title = Ui.tv(this, "未来清单", 32, Ui.text, "sans-serif-medium");
        LinearLayout.LayoutParams tp = new LinearLayout.LayoutParams(0, Widgets.WRAP, 1f);
        tp.leftMargin = dp(16);
        row.addView(title, tp);
        return row;
    }

    private View bannerCard() {
        LinearLayout card = new LinearLayout(this);
        card.setOrientation(LinearLayout.VERTICAL);
        card.setBackground(Ui.shape(this, Ui.primaryC, 28));
        card.setPadding(dp(22), dp(20), dp(22), dp(20));
        card.addView(Ui.tv(this, "跨越时间的郑重提醒", 17, Ui.onPrimaryC, "sans-serif-medium"));
        TextView sub = Ui.tv(this, "无论是三个月后的待办，还是家人的生日。到点后需亲手输入「我已知晓」方可解除，否则将持续追呼，绝不错过。",
                13, Ui.onPrimaryC, "sans-serif");
        sub.setPadding(0, dp(6), 0, 0);
        sub.setAlpha(0.85f);
        card.addView(sub);
        return card;
    }
    private View addFab() {
        TextView fab = Ui.tv(this, "＋  新建远期提醒", 15, Ui.onTertiaryC, "sans-serif-medium");
        fab.setGravity(Gravity.CENTER);
        fab.setPadding(dp(24), dp(18), dp(26), dp(18));
        fab.setBackground(Ui.ripple(Ui.shape(this, Ui.tertiaryC, 22)));
        fab.setElevation(dp(6));
        fab.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) { showEditor(null); }
        });
        return fab;
    }

    private FrameLayout.LayoutParams fabParams() {
        FrameLayout.LayoutParams fp = new FrameLayout.LayoutParams(
                Widgets.WRAP, Widgets.WRAP, Gravity.BOTTOM | Gravity.END);
        fp.setMargins(0, 0, dp(20), dp(48));
        return fp;
    }

    private void refreshList() {
        if (listContainer == null) return;
        listContainer.removeAllViews();
        List<FutureStore.Item> items = FutureStore.all(this);
        if (items.isEmpty()) {
            LinearLayout emp = new LinearLayout(this);
            emp.setOrientation(LinearLayout.VERTICAL);
            emp.setGravity(Gravity.CENTER_HORIZONTAL);
            emp.setPadding(0, dp(48), 0, dp(24));
            emp.addView(Ui.tv(this, "⏳", 52, Ui.text, "sans-serif"));
            TextView t1 = Ui.tv(this, "暂无远期提醒", 19, Ui.text, "sans-serif-medium");
            t1.setPadding(0, dp(14), 0, dp(4));
            emp.addView(t1);
            emp.addView(Ui.tv(this, "点右下角记录生日、纪念日或几个月后的重要事项", 13.5f, Ui.textVar, "sans-serif"));
            listContainer.addView(emp);
            return;
        }
        for (int i = 0; i < items.size(); i++) {
            final FutureStore.Item it = items.get(i);
            LinearLayout card = new LinearLayout(this);
            card.setOrientation(LinearLayout.VERTICAL);
            card.setBackground(Ui.ripple(Ui.shape(this, Ui.surface, 26)));
            card.setPadding(dp(22), dp(18), dp(22), dp(18));
            card.setAlpha(it.done ? 0.55f : 1f);

            LinearLayout top = new LinearLayout(this);
            top.setGravity(Gravity.CENTER_VERTICAL);
            TextView tt = Ui.tv(this, it.title, 18, Ui.text, "sans-serif-medium");
            top.addView(tt, new LinearLayout.LayoutParams(0, Widgets.WRAP, 1f));
            TextView badge = Ui.tv(this, it.remainText(), 12.5f,
                    it.done ? Ui.textVar : Ui.primary, "sans-serif-medium");
            top.addView(badge);
            card.addView(top);

            if (!it.note.isEmpty()) {
                TextView nt = Ui.tv(this, it.note, 14, Ui.textVar, "sans-serif");
                nt.setPadding(0, dp(6), 0, 0);
                card.addView(nt);
            }
            TextView dt = Ui.tv(this, "提醒时间：" + it.dateTimeText(), 12.5f, Ui.textVar, "sans-serif");
            dt.setPadding(0, dp(8), 0, 0);
            card.addView(dt);

            card.setOnClickListener(new View.OnClickListener() {
                @Override
                public void onClick(View v) { showEditor(it); }
            });
            LinearLayout.LayoutParams cp = new LinearLayout.LayoutParams(Widgets.MATCH, Widgets.WRAP);
            cp.topMargin = dp(12);
            listContainer.addView(card, cp);
        }
    }
    private void rebuildWheels(LinearLayout host, final Calendar cal, final TextView previewTv) {
        host.removeAllViews();
        final Runnable updatePreview = new Runnable() {
            @Override
            public void run() {
                previewTv.setText(String.format(Locale.US, "已选定：%04d年%02d月%02d日  %02d:%02d",
                        cal.get(Calendar.YEAR), cal.get(Calendar.MONTH) + 1,
                        cal.get(Calendar.DAY_OF_MONTH), cal.get(Calendar.HOUR_OF_DAY),
                        cal.get(Calendar.MINUTE)));
            }
        };

        // 1. 顶部醒目的「时 : 分」大号放大滚轮（与新建闹钟同款手感）
        LinearLayout timeRow = new LinearLayout(this);
        timeRow.setOrientation(LinearLayout.HORIZONTAL);
        timeRow.setGravity(Gravity.CENTER);
        timeRow.setClipChildren(false);
        timeRow.setClipToPadding(false);

        PickerStyle.WheelPicker hp = PickerStyle.create(this, 0, 23, cal.get(Calendar.HOUR_OF_DAY), new Widgets.IntCb() {
            @Override
            public void on(int v) { cal.set(Calendar.HOUR_OF_DAY, v); updatePreview.run(); }
        });
        TextView colon = Ui.tv(this, ":", 40, Ui.textVar, "sans-serif-medium");
        colon.setPadding(dp(4), 0, dp(4), dp(6));
        PickerStyle.WheelPicker mp = PickerStyle.create(this, 0, 59, cal.get(Calendar.MINUTE), new Widgets.IntCb() {
            @Override
            public void on(int v) { cal.set(Calendar.MINUTE, v); updatePreview.run(); }
        });
        timeRow.addView(hp, new LinearLayout.LayoutParams(dp(136), dp(176)));
        timeRow.addView(colon);
        timeRow.addView(mp, new LinearLayout.LayoutParams(dp(136), dp(176)));
        host.addView(timeRow);

        // 2. 「年 · 月 · 日」三列远期滚轮卡片
        LinearLayout dateCard = new LinearLayout(this);
        dateCard.setOrientation(LinearLayout.VERTICAL);
        dateCard.setBackground(Ui.shape(this, Ui.surface, 24));
        dateCard.setPadding(dp(12), dp(12), dp(12), dp(8));
        dateCard.setClipChildren(false);
        dateCard.setClipToPadding(false);

        LinearLayout headRow = new LinearLayout(this);
        String[] hLabels = {"年份 (20xx)", "月份", "日期"};
        for (String s : hLabels) {
            TextView ht = Ui.tv(this, s, 12.5f, Ui.textVar, "sans-serif-medium");
            ht.setGravity(Gravity.CENTER);
            headRow.addView(ht, new LinearLayout.LayoutParams(0, Widgets.WRAP, 1f));
        }
        dateCard.addView(headRow);

        LinearLayout dateWheels = new LinearLayout(this);
        dateWheels.setGravity(Gravity.CENTER);
        dateWheels.setClipChildren(false);
        dateWheels.setClipToPadding(false);

        int yrShort = Math.max(26, Math.min(35, cal.get(Calendar.YEAR) - 2000));
        PickerStyle.WheelPicker yp = PickerStyle.create(this, 26, 35, yrShort, new Widgets.IntCb() {
            @Override
            public void on(int v) { cal.set(Calendar.YEAR, 2000 + v); updatePreview.run(); }
        });
        PickerStyle.WheelPicker mop = PickerStyle.create(this, 1, 12, cal.get(Calendar.MONTH) + 1, new Widgets.IntCb() {
            @Override
            public void on(int v) {
                cal.set(Calendar.MONTH, v - 1);
                updatePreview.run();
            }
        });
        PickerStyle.WheelPicker dpPicker = PickerStyle.create(this, 1, 31, cal.get(Calendar.DAY_OF_MONTH), new Widgets.IntCb() {
            @Override
            public void on(int v) { cal.set(Calendar.DAY_OF_MONTH, v); updatePreview.run(); }
        });

        dateWheels.addView(yp, new LinearLayout.LayoutParams(0, dp(152), 1f));
        dateWheels.addView(mop, new LinearLayout.LayoutParams(0, dp(152), 1f));
        dateWheels.addView(dpPicker, new LinearLayout.LayoutParams(0, dp(152), 1f));
        dateCard.addView(dateWheels);

        LinearLayout.LayoutParams dcp = new LinearLayout.LayoutParams(Widgets.MATCH, Widgets.WRAP);
        dcp.topMargin = dp(6);
        host.addView(dateCard, dcp);
        updatePreview.run();
    }
    private void showEditor(final FutureStore.Item src) {
        final boolean isNew = (src == null);
        final FutureStore.Item d = isNew ? new FutureStore.Item() : src;
        final Calendar cal = Calendar.getInstance();
        if (isNew) {
            cal.add(Calendar.DAY_OF_YEAR, 1);
            cal.set(Calendar.HOUR_OF_DAY, 9);
            cal.set(Calendar.MINUTE, 0);
            cal.set(Calendar.SECOND, 0);
            d.triggerAt = cal.getTimeInMillis();
        } else {
            cal.setTimeInMillis(d.triggerAt);
        }

        final Dialog dlg = new Dialog(this);
        dlg.requestWindowFeature(Window.FEATURE_NO_TITLE);
