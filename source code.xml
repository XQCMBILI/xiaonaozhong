package com.alarm.application;

import android.app.Dialog;
import android.view.Gravity;
import android.view.LayoutInflater;
import android.view.Window;
import android.widget.EditText;
import android.widget.LinearLayout;
import android.widget.TextView;
import android.widget.TimePicker;

import java.util.Calendar;

final class EditorSheet {
    private final MainActivity act;

    EditorSheet(MainActivity a) {
        act = a;
    }

    private int dp(float v) {
        return Ui.dp(act, v);
    }

    private Alarm newAlarm() {
        Alarm a = new Alarm();
        Calendar c = Calendar.getInstance();
        a.hour = (c.get(Calendar.HOUR_OF_DAY) + 1) % 24;
        a.minute = 0;
        return a;
    }

    void show(Alarm src) {
        boolean isNew = src == null;
        final Alarm d = isNew ? newAlarm() : src.copy();
        Dialog dlg = new Dialog(act.themeContext());
        dlg.requestWindowFeature(Window.FEATURE_NO_TITLE);
        LinearLayout box = Sheet.box(act, isNew ? "新建闹钟" : "编辑闹钟");
        box.setClipChildren(false);

        final TimePicker tp = (TimePicker) LayoutInflater.from(act.themeContext())
                .inflate(R.layout.time_spinner, null);
        tp.setIs24HourView(true);
        tp.setCurrentHour(d.hour);
        tp.setCurrentMinute(d.minute);

        LinearLayout timeRow = new LinearLayout(act);
        timeRow.setOrientation(LinearLayout.HORIZONTAL);
        timeRow.setGravity(Gravity.CENTER);
        timeRow.setClipChildren(false);
        timeRow.setClipToPadding(false);

        PickerStyle.WheelPicker hp = PickerStyle.create(act, 0, 23, d.hour, new Widgets.IntCb() {
            @Override
            public void on(int v) {
                d.hour = v;
                tp.setCurrentHour(v);
            }
        });
        TextView colon = Ui.tv(act, ":", 44, Ui.textVar, "sans-serif-medium");
        colon.setPadding(dp(2), 0, dp(2), dp(6));
        PickerStyle.WheelPicker mp = PickerStyle.create(act, 0, 59, d.minute, new Widgets.IntCb() {
            @Override
            public void on(int v) {
                d.minute = v;
                tp.setCurrentMinute(v);
            }
        });

        // 尺寸升级至 152dp 宽 × 204dp 高，完美展现 70sp+ 超大选中数字
        timeRow.addView(hp, new LinearLayout.LayoutParams(dp(152), dp(204)));
        timeRow.addView(colon, new LinearLayout.LayoutParams(Widgets.WRAP, Widgets.WRAP));
        timeRow.addView(mp, new LinearLayout.LayoutParams(dp(152), dp(204)));

        LinearLayout.LayoutParams tpp = new LinearLayout.LayoutParams(Widgets.MATCH, Widgets.WRAP);
        tpp.topMargin = dp(12);
        tpp.bottomMargin = dp(8);
        box.addView(timeRow, tpp);

        SecondRow sec = new SecondRow(act, d);
        LinearLayout.LayoutParams secParams = new LinearLayout.LayoutParams(Widgets.MATCH, Widgets.WRAP);
        secParams.topMargin = dp(8);
        secParams.bottomMargin = dp(16);
        box.addView(sec.view(), secParams);

        box.addView(Widgets.sectionLabel(act, "重复"));
        box.addView(RepeatRow.build(act, d));

        box.addView(Widgets.sectionLabel(act, "名称"));
        EditText et = new EditText(act);
        et.setText(d.label);
        et.setHint("例如：起床、上早八");
        et.setSingleLine(true);
        et.setTextSize(16);
        et.setTextColor(Ui.text);
        et.setHintTextColor(Ui.textVar);
        et.setBackground(Ui.shape(act, Ui.surface, 24));
        et.setPadding(dp(24), dp(18), dp(24), dp(18));
        box.addView(et, new LinearLayout.LayoutParams(Widgets.MATCH, Widgets.WRAP));

        box.addView(Widgets.sectionLabel(act, "铃声"));
        box.addView(new SoundPicker(act, d).row(),
                new LinearLayout.LayoutParams(Widgets.MATCH, Widgets.WRAP));

        EditorOptions.add(act, box, d);

        LinearLayout.LayoutParams bp = new LinearLayout.LayoutParams(Widgets.MATCH, Widgets.WRAP);
        bp.topMargin = dp(32);
        box.addView(EditorBar.build(act, dlg, d, tp, sec, et, isNew), bp);
        Sheet.open(dlg, act, box);
    }
}
