package com.alarm.application;

import android.app.Dialog;
import android.content.Intent;
import android.database.Cursor;
import android.media.Ringtone;
import android.media.RingtoneManager;
import android.net.Uri;
import android.provider.OpenableColumns;
import android.view.Gravity;
import android.view.View;
import android.view.Window;
import android.widget.LinearLayout;
import android.widget.TextView;

final class SoundPicker {
    static SoundPicker current;
    private static final int REQ_SYS = 11;
    private static final int REQ_FILE = 12;

    private final MainActivity act;
    private final Alarm d;
    private TextView label;

    SoundPicker(MainActivity a, Alarm alarm) {
        act = a;
        d = alarm;
        current = this;
    }

    View row() {
        LinearLayout sr = new LinearLayout(act);
        sr.setOrientation(LinearLayout.VERTICAL);
        sr.setBackground(Ui.ripple(Ui.shape(act, Ui.surface, 24)));
        sr.setPadding(Ui.dp(act, 20), Ui.dp(act, 14), Ui.dp(act, 20), Ui.dp(act, 14));
        sr.addView(Ui.tv(act, "选择铃声", 16, Ui.text, "sans-serif-medium"));
        label = Ui.tv(act, name(d.ringtone), 13, Ui.textVar, "sans-serif");
        label.setPadding(0, Ui.dp(act, 2), 0, 0);
        sr.addView(label);
        sr.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                choose();
            }
        });
        return sr;
    }
    private void choose() {
        final Dialog dlg = new Dialog(act);
        dlg.requestWindowFeature(Window.FEATURE_NO_TITLE);

        LinearLayout box = new LinearLayout(act);
        box.setOrientation(LinearLayout.VERTICAL);
        box.setPadding(Ui.dp(act, 24), Ui.dp(act, 24), Ui.dp(act, 24), Ui.dp(act, 16));
        // M3 超大圆角弹窗底板
        box.setBackground(Ui.shape(act, Ui.bg, 28));

        TextView title = Ui.tv(act, "选择铃声", 20, Ui.text, "sans-serif-medium");
        title.setPadding(0, 0, 0, Ui.dp(act, 20));
        box.addView(title);

        // 核心要求 1：修改文案，加上“默认铃声”
        String[] items = {"系统闹钟铃声", "手机里的音频文件", "默认铃声 - Fresh morning"};
        for (int i = 0; i < items.length; i++) {
            final int idx = i;
            LinearLayout row = new LinearLayout(act);
            row.setOrientation(LinearLayout.HORIZONTAL);
            row.setGravity(Gravity.CENTER_VERTICAL);
            
            // M3 风格：淡紫色的胶囊背景块
            int itemBg = Tones.alpha(Ui.primary, Ui.dark ? 30 : 15);
            row.setBackground(Ui.ripple(Ui.shape(act, itemBg, 16)));
            row.setPadding(Ui.dp(act, 20), Ui.dp(act, 18), Ui.dp(act, 20), Ui.dp(act, 18));
            
            LinearLayout.LayoutParams rp = new LinearLayout.LayoutParams(Widgets.MATCH, Widgets.WRAP);
            rp.bottomMargin = Ui.dp(act, 12);

            // 前置的紫色小圆点
            TextView dot = Ui.tv(act, "●", 12, Ui.primary, "sans-serif");
            dot.setPadding(0, 0, Ui.dp(act, 14), 0);
            row.addView(dot);

            TextView text = Ui.tv(act, items[i], 16, Ui.text, "sans-serif-medium");
            row.addView(text);

            row.setOnClickListener(new View.OnClickListener() {
                @Override
                public void onClick(View v) {
                    if (idx == 0) pickSystem();
                    else if (idx == 1) pickFile();
                    else {
                        d.ringtone = "android.resource://" + act.getPackageName() + "/" + R.raw.fresh_morning;
                        label.setText(name(d.ringtone));
                    }
                    dlg.dismiss();
                }
            });
            box.addView(row, rp);
        }

        LinearLayout btns = new LinearLayout(act);
        btns.setGravity(Gravity.END);
        
        TextView btnCancel = Ui.tv(act, "取消", 14, Ui.primary, "sans-serif-medium");
        btnCancel.setPadding(Ui.dp(act, 16), Ui.dp(act, 10), Ui.dp(act, 16), Ui.dp(act, 10));
        btnCancel.setBackground(Ui.ripple(Ui.shape(act, 0, 20))); 
        btnCancel.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) { dlg.dismiss(); }
        });
        btns.addView(btnCancel);
        box.addView(btns);

        dlg.setContentView(box);
        Window window = dlg.getWindow();
        if (window != null) {
            window.setBackgroundDrawable(new android.graphics.drawable.ColorDrawable(0));
            window.setLayout((int) (act.getResources().getDisplayMetrics().widthPixels * 0.9), Widgets.WRAP);
            window.setDimAmount(0.45f);
        }
        dlg.show();
    }
    private void pickSystem() {
        Intent it = new Intent(RingtoneManager.ACTION_RINGTONE_PICKER);
        it.putExtra(RingtoneManager.EXTRA_RINGTONE_TYPE, RingtoneManager.TYPE_ALARM);
        it.putExtra(RingtoneManager.EXTRA_RINGTONE_TITLE, "选择闹钟铃声");
        it.putExtra(RingtoneManager.EXTRA_RINGTONE_SHOW_DEFAULT, true);
        it.putExtra(RingtoneManager.EXTRA_RINGTONE_SHOW_SILENT, false);
        if (!d.ringtone.isEmpty()) {
            it.putExtra(RingtoneManager.EXTRA_RINGTONE_EXISTING_URI, Uri.parse(d.ringtone));
        }
        act.startActivityForResult(it, REQ_SYS);
    }

    private void pickFile() {
        Intent it = new Intent(Intent.ACTION_OPEN_DOCUMENT);
        it.addCategory(Intent.CATEGORY_OPENABLE);
        it.setType("audio/*");
        it.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION
                | Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION);
        act.startActivityForResult(it, REQ_FILE);
    }

    void onResult(int req, int res, Intent data) {
        if (res != android.app.Activity.RESULT_OK || data == null) return;
        if (req == REQ_SYS) {
            Uri u = (Uri) data.getParcelableExtra(RingtoneManager.EXTRA_RINGTONE_PICKED_URI);
            d.ringtone = u == null ? "" : u.toString();
        } else if (req == REQ_FILE) {
            Uri u = data.getData();
            if (u != null) {
                try {
                    act.getContentResolver().takePersistableUriPermission(
                            u, Intent.FLAG_GRANT_READ_URI_PERMISSION);
                } catch (Exception ignored) {
                }
                d.ringtone = u.toString();
            }
        } else {
            return;
        }
        if (label != null) label.setText(name(d.ringtone));
    }

    private String name(String u) {
        if (u == null || u.isEmpty()) return "默认铃声 - Fresh morning";
        
        if (u.equals("android.resource://" + act.getPackageName() + "/" + R.raw.fresh_morning)) {
            return "默认铃声 - Fresh morning";
        }
        
        Uri uri = Uri.parse(u);
        Cursor c = null;
        try {
            c = act.getContentResolver().query(
                    uri, new String[]{OpenableColumns.DISPLAY_NAME}, null, null, null);
            if (c != null && c.moveToFirst()) {
                String n = c.getString(0);
                if (n != null) return n.replaceAll("\\.[A-Za-z0-9]{2,4}$", "");
            }
        } catch (Exception ignored) {
        } finally {
            if (c != null) c.close();
        }
        try {
            Ringtone r = RingtoneManager.getRingtone(act, uri);
            if (r != null) return r.getTitle(act);
        } catch (Exception ignored) {
        }
        return "自定义铃声";
    }
}
