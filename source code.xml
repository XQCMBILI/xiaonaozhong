package com.alarm.application;

import android.app.Activity;
import android.content.Context;
import android.os.Bundle;
import android.os.Handler;
import android.os.Looper;
import android.os.PowerManager;
import android.view.Gravity;
import android.view.View;
import android.view.ViewGroup;
import android.view.Window;
import android.view.WindowManager;
import android.widget.EditText;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;

public class FutureRingActivity extends Activity {
    private FutureStore.Item item;
    private AlarmSound sound;
    private PowerManager.WakeLock wl;
    private boolean resolved = false;
    private final Handler h = new Handler(Looper.getMainLooper());

    // 若 5 分钟无人理会，自动挂起并在 5 分钟后再次追呼提醒
    private final Runnable autoRepeat = new Runnable() {
        @Override
        public void run() {
            if (!resolved && item != null) {
                postpone(5 * 60 * 1000L);
            }
        }
    };

    private int dp(float v) { return Ui.dp(this, v); }
    @Override
    protected void onCreate(Bundle b) {
        super.onCreate(b);
        Ui.init(this);
        int id = getIntent().getIntExtra("future_id", -1);
        item = FutureStore.get(this, id);
        if (item == null || item.done) {
            finish();
            return;
        }

        Window w = getWindow();
        w.addFlags(WindowManager.LayoutParams.FLAG_SHOW_WHEN_LOCKED
                | WindowManager.LayoutParams.FLAG_TURN_SCREEN_ON
                | WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON
                | WindowManager.LayoutParams.FLAG_DISMISS_KEYGUARD
                | WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS);
        w.setStatusBarColor(Ui.bg);
        w.setNavigationBarColor(Ui.bg);

        PowerManager pm = (PowerManager) getSystemService(Context.POWER_SERVICE);
        if (pm != null) {
            wl = pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK | PowerManager.ACQUIRE_CAUSES_WAKEUP, "future:ring");
            wl.acquire(5 * 60 * 1000L);
        }

        Alarm dummy = new Alarm();
        dummy.gradual = true;
        dummy.rampSec = 20;
        dummy.vibrate = true;
        sound = new AlarmSound(this);
        sound.start(dummy);
        h.postDelayed(autoRepeat, 5 * 60 * 1000L);

        buildUi();
    }
    private void buildUi() {
        ScrollView sv = new ScrollView(this);
        sv.setFillViewport(true);
        sv.setBackgroundColor(Ui.bg);

        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setGravity(Gravity.CENTER_HORIZONTAL);
        root.setPadding(dp(24), dp(56), dp(24), dp(36));

        TextView tag = Ui.tv(this, "📅  未来清单 · 重要提醒", 15, Ui.primary, "sans-serif-medium");
        root.addView(tag);

        LinearLayout card = new LinearLayout(this);
        card.setOrientation(LinearLayout.VERTICAL);
        card.setGravity(Gravity.CENTER_HORIZONTAL);
        card.setBackground(Ui.shape(this, Ui.surface, 32));
        card.setPadding(dp(22), dp(26), dp(22), dp(24));
        LinearLayout.LayoutParams cp = new LinearLayout.LayoutParams(Widgets.MATCH, Widgets.WRAP);
        cp.topMargin = dp(20);

        TextView title = Ui.tv(this, item.title, 26, Ui.text, "sans-serif-medium");
        title.setGravity(Gravity.CENTER);
        card.addView(title);

        if (!item.note.isEmpty()) {
            TextView note = Ui.tv(this, item.note, 16, Ui.textVar, "sans-serif");
            note.setGravity(Gravity.CENTER);
            note.setPadding(0, dp(10), 0, 0);
            card.addView(note);
        }

        final TextView prompt = Ui.tv(this, "请在下方输入「我已知晓」四个字以解除此项提醒：",
                14, Ui.textVar, "sans-serif-medium");
        prompt.setPadding(0, dp(24), 0, dp(10));
        card.addView(prompt);

        final EditText input = new EditText(this);
        input.setHint("在此输入：我已知晓");
        input.setSingleLine(true);
        input.setGravity(Gravity.CENTER);
        input.setTextSize(20);
        input.setTextColor(Ui.primary);
        input.setHintTextColor(Ui.textVar);
        input.setBackground(Ui.shape(this, Ui.bg, 20));
        input.setPadding(dp(16), dp(16), dp(16), dp(16));
        card.addView(input, new LinearLayout.LayoutParams(Widgets.MATCH, Widgets.WRAP));
        root.addView(card, cp);

        TextView confirm = Ui.tv(this, "确认知晓并永久关闭", 17, Ui.onPrimary, "sans-serif-medium");
        confirm.setGravity(Gravity.CENTER);
        confirm.setBackground(Ui.ripple(Ui.shape(this, Ui.primary, 100)));
        LinearLayout.LayoutParams vp = new LinearLayout.LayoutParams(Widgets.MATCH, dp(62));
        vp.topMargin = dp(20);
        root.addView(confirm, vp);

        confirm.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                String s = input.getText().toString().trim();
                if ("我已知晓".equals(s)) {
                    resolved = true;
                    item.done = true;
                    FutureStore.upsert(FutureRingActivity.this, item);
                    cleanup();
                    finish();
                } else {
                    prompt.setTextColor(Ui.error);
                    prompt.setText("输入不匹配！必须准确输入「我已知晓」四个字：");
                }
            }
        });
        LinearLayout snoozeRow = new LinearLayout(this);
        snoozeRow.setOrientation(LinearLayout.HORIZONTAL);
        LinearLayout.LayoutParams sp = new LinearLayout.LayoutParams(Widgets.MATCH, Widgets.WRAP);
        sp.topMargin = dp(12);

        TextView later5 = Ui.tv(this, "5 分钟后再提醒", 15, Ui.onTertiaryC, "sans-serif-medium");
        later5.setGravity(Gravity.CENTER);
        later5.setBackground(Ui.ripple(Ui.shape(this, Ui.tertiaryC, 100)));
        later5.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) { postpone(5 * 60 * 1000L); }
        });

        TextView tomorrow = Ui.tv(this, "明天此时再提醒", 15, Ui.onPrimaryC, "sans-serif-medium");
        tomorrow.setGravity(Gravity.CENTER);
        tomorrow.setBackground(Ui.ripple(Ui.shape(this, Ui.primaryC, 100)));
        tomorrow.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) { postpone(24 * 60 * 60 * 1000L); }
        });

        LinearLayout.LayoutParams p1 = new LinearLayout.LayoutParams(0, dp(54), 1f);
        p1.rightMargin = dp(10);
        snoozeRow.addView(later5, p1);
        snoozeRow.addView(tomorrow, new LinearLayout.LayoutParams(0, dp(54), 1f));
        root.addView(snoozeRow, sp);

        sv.addView(root);
        setContentView(sv);
    }

    private void postpone(long delayMs) {
        resolved = true;
        if (item != null) {
            item.triggerAt = System.currentTimeMillis() + delayMs;
            item.done = false;
            FutureStore.upsert(this, item);
        }
        cleanup();
        finish();
    }

    private void cleanup() {
        h.removeCallbacksAndMessages(null);
        if (sound != null) {
            sound.stop();
            sound = null;
        }
        if (wl != null && wl.isHeld()) wl.release();
        wl = null;
    }

    @Override
    public void onBackPressed() {
        // 屏蔽返回键，必须输入“我已知晓”或选择延后
    }

    @Override
    protected void onDestroy() {
        // 如果未输入“我已知晓”被意外关闭或划掉，自动设定 5 分钟后再次提醒，绝不漏掉
        if (!resolved && item != null && !item.done) {
            item.triggerAt = System.currentTimeMillis() + 5 * 60 * 1000L;
            FutureStore.upsert(this, item);
        }
        cleanup();
        super.onDestroy();
    }
}
</file>

